    <config>
        <fields name="params">
            <fieldset name="advanced">
                
                <field name="templateColor" class="" type="color" default="#08C"
                       label="TPL_INOXHOANGANH_COLOR_LABEL"
                       description="TPL_INOXHOANGANH_COLOR_DESC" />

                <field name="templateBackgroundColor" class="" type="color" default="#F4F6F7"
                       label="TPL_INOXHOANGANH_BACKGROUND_COLOR_LABEL"
                       description="TPL_INOXHOANGANH_BACKGROUND_COLOR_DESC" />
                
                <field name="buttonColor" class="" type="color" default="#5bc0de"
                       label="TPL_INOXHOANGANH_BUTTON_COLOR_LABEL"
                       description="TPL_INOXHOANGANH_BUTTON_COLOR_DESC" />
                
                <field name="loadmore"
                       type="radio"
                       class="btn-group btn-group-yesno"
                       default="1"
                       label="TPL_INOXHOANGANH_LOAD_MORE_LABEL"
                       description="TPL_INOXHOANGANH_LOAD_MORE_DESC"
                >
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>
                
                <field name="logo" class="" type="media" default=""
                       label="TPL_INOXHOANGANH_LOGO_LABEL"
                       description="TPL_INOXHOANGANH_LOGO_DESC" />
                <field name="logoLogin" class="" type="media" default=""
                       label="TPL_INOXHOANGANH_LOGO_LOGIN_LABEL"
                       description="TPL_INOXHOANGANH_LOGO_LOGIN_DESC" />
                
                <field name="logoMobile" class="" type="media" default=""
                       label="TPL_INOXHOANGANH_LOGO_MOBILE_LABEL"
                       description="TPL_INOXHOANGANH_LOGO_MOBILE_DESC" />
                <field name="logoLoginMobile" class="" type="media" default=""
                       label="TPL_INOXHOANGANH_LOGO_LOGIN_MOBILE_LABEL"
                       description="TPL_INOXHOANGANH_LOGO_LOGIN_MOBILE_DESC" />

                <field name="sitetitle"  type="text" default=""
                       label="JGLOBAL_TITLE"
                       description="JFIELD_ALT_PAGE_TITLE_LABEL"
                       filter="string" />

                <field name="sitedescription"  type="textarea" default=""
                       label="JGLOBAL_DESCRIPTION"
                       description="JGLOBAL_SUBHEADING_DESC"
                       filter="string" />
                
                <field name="logofooter" class="" type="media" default=""
                       label="TPL_INOXHOANGANH_LOGO_FOOTER_LABEL"
                       description="TPL_INOXHOANGANH_LOGO_FOOTER_DESC" />
                
                <field name="logomobilefooter" class="" type="media" default=""
                       label="TPL_INOXHOANGANH_LOGO_FOOTER_MOBILE_LABEL"
                       description="TPL_INOXHOANGANH_LOGO_FOOTER_MOBILE_DESC" />

                <field name="sitetitlefooter"  type="text" default=""
                       label="JGLOBAL_TITLE_FOOTER"
                       description="JFIELD_ALT_PAGE_TITLE_FOOTER_LABEL"
                       filter="string" />
                
                <field name="sitedescriptionfooter"  type="textarea" default=""
                       label="JGLOBAL_DESCRIPTION_FOOTER"
                       description="JGLOBAL_DESCRIPTION_FOOTER_DESC"
                       filter="string" />

                <field name="googleFont"
                       type="radio"
                       class="btn-group btn-group-yesno"
                       default="1"
                       label="TPL_INOXHOANGANH_FONT_LABEL"
                       description="TPL_INOXHOANGANH_FONT_DESC"
                >
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>

                <field name="googleFontName" class="" type="text" default="Open+Sans"
                       label="TPL_INOXHOANGANH_FONT_NAME_LABEL"
                       description="TPL_INOXHOANGANH_FONT_NAME_DESC" 
                       showon="googleFont:1" />
                
                <field name="googleFontDisplay" class="" type="text" default="swap"
                       label="TPL_INOXHOANGANH_FONT_DISPLAY_LABEL"
                       description="TPL_INOXHOANGANH_FONT_DISPLAY_DESC" 
                       showon="googleFont:1" />

                <field name="fluidContainer"
                       type="radio"
                       class="btn-group btn-group-yesno"
                       default="0"
                       label="TPL_INOXHOANGANH_FLUID_LABEL"
                       description="TPL_INOXHOANGANH_FLUID_DESC"
                >
                    <option value="1">TPL_INOXHOANGANH_FLUID</option>
                    <option value="0">TPL_INOXHOANGANH_STATIC</option>
                </field>
                
                <field name="tooltip"
                       type="radio"
                       class="btn-group btn-group-yesno"
                       default="1"
                       label="BOOTSTAP_TOOLTIP_LABEL"
                       description="TPL_BOOTSTAP_TOOLTIP_DESC"
                >
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>
                
                <field name="tooltip_viewport" type="list" default="hasTooltip"
                       label="TPL_TOOLTIP_VIEWPORT_LABEL"
                       description="TPL_TOOLTIP_VIEWPORT_DESC"
                       showon="tooltip:1"
                >
                    <option value="hasTooltip">hasTooltip</option>
                    <option value="hasPopover">hasPopover</option>
                </field>
                
                <field name="addtocart_popup"
                       type="radio"
                       class="btn-group btn-group-yesno"
                       default="1"
                       label="ADDTOCART_POPUP_LABEL"
                       description="TPL_ADDTOCART_POPUP_DESC"
                >
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>
                
                <field name="useMenus" 
                       type="list" 
                       default=""
                       label="TPL_USE_MENUS_LABEL"
                       description="TPL_USE_MENUS_DESC"
                >
                    <option value="">TPL_USE_DEFAULT_MENUS</option>
                    <option value="smart-menus">TPL_USE_SMART_MENUS</option>
                </field> 
                
                <field name="menuType" 
                       type="list" 
                       default=""
                       label="TPL_MENU_TYPE_LABEL"
                       description="TPL_MENU_TYPE_DESC"
                >
                    <option value="">TPL_MENU_TYPE_NAVIGATION_BAR</option>
                    <option value="fixed-top">TPL_MENU_TYPE_FIXED_TOP</option>
                    <option value="fixed-bottom">TPL_MENU_TYPE_FIXED_BOTTOM</option>
                </field> 
                
                <field name="stickyMenu"
                       type="radio"
                       class="btn-group btn-group-yesno"
                       default="0"
                       label="TPL_STICKYMENU_LABEL"
                       description="TPL_STICKYMENU_DESC"
                >
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>
                
                <field name="slider"
                       type="radio"
                       class="btn-group btn-group-yesno"
                       default="0"
                       label="TPL_SLIDER_LABEL"
                       description="TPL_SLIDER_DESC"
                >
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>
                
                <field name="navmasthead"
                       type="radio"
                       class="btn-group btn-group-yesno"
                       default="0"
                       label="TPL_NAV_MASTHEAD_LABEL"
                       description="TPL_NAV_MASTHEAD_DESC"
                >
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>
                
                <field name="slidername" type="list" default="3"
                       label="TPL_SLIDERNAME_LABEL"
                       description="TPL_SLIDERNAME_DESC"
                       showon="slider:1"
                >
                    <option value="3">3</option>
                    <option value="4">4</option>
                    <option value="5">5</option>
                    <option value="6">6</option>
                    <option value="7">7</option>
                    <option value="8">8</option>
                    <option value="9">9</option>
                    <option value="10">10</option>
                    <option value="11">11</option>
                    <option value="12">12</option>
                </field>
                
                <field name="widthcolumn_leftright" type="list" default="center"
                       label="Width column (left and right)"
                       description="Layout: width column (left and right)"
                >
                    <option value="3">3</option>
                    <option value="4">4</option>
                    <option value="5">5</option>
                    <option value="6">6</option>
                </field>
                
                <field name="widthcolumn" type="list" default="center"
                       label="Width column (left or right)"
                       description="Layout: width column (left or right)"
                >
                    <option value="3">3</option>
                    <option value="4">4</option>
                    <option value="5">5</option>
                    <option value="6">6</option>
                </field>
                
                <field name="prefix_extrasmall" class="" type="text" default="col-" label="Prefix extra small devices "  description="Extra small devices Phones (&lt;576px)" />
                <field name="prefix_small" class="" type="text" default="col-sm-" label="Prefix small devices " description="Small devices Tablets (≥576px)"/>
                <field name="prefix_medium" class="" type="text" default="col-md-" label="Prefix medium devices " description="Medium devices Desktops (≥768px)"/>
                <field name="prefix_large" class="" type="text" default="col-lg-" label="Prefix large devices" description="Large devices Desktops (≥992px)"/>
                <field name="prefix_extralarge" class="" type="text" default="col-xl-" label="Prefix Extra large devices" description="Extra large devices Desktops (≥1200px)"/>
                
                <field name="animated"
                       type="radio"
                       class="btn-group btn-group-yesno"
                       default="0"
                       label="TPL_ANIMATED_SCROLL_EFFECTS_LABEL"
                >
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>
                <field name="offset" 
                       type="number" 
                       label="TPL_OFFSET_LABEL" 
                       description="TPL_OFFSET_DESC"
                       default="100" 
                       min="1"
                       step="1" 
                       showon="animated:1"
                />
                <field name="scroll_effect" type="list" default="center"
                       label="TPL_SCROLL_EFFECTS_LABEL"
                       description="TPL_SCROLL_EFFECTS_DESC"
                       showon="animated:1"
                >
                    <option value="fadeIn">Fade In</option>
                    <option value="bounceInLeft">Bounce In Left</option>
                    <option value="bounceInUp">Bounce In Up</option>
                    <option value="fadeInDown">Fade In Down</option>
                    <option value="lightSpeedIn">Light Speed In</option>
                    <option value="flipInX">Flip In X</option>
                </field>
            </fieldset>
        </fields>
    </config>
</extension>
