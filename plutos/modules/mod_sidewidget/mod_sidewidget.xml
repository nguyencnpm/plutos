<?xml version="1.0" encoding="utf-8"?>
<extension type="module" version="3.1" client="site" method="upgrade">
    <name>mod_sidewidget</name>
    <author>Binh Nguyen! Project</author>
    <creationDate>May 2007</creationDate>
    <copyright>Copyright (C) 2005 - 2017 Open Source Matters. All rights reserved.</copyright>
    <license>GNU General Public License version 2 or later; see LICENSE.txt</license>
    <authorEmail>admin@giaiphapcongnghethongtin.vn</authorEmail>
    <authorUrl>www.giaiphapcongnghethongtin.vn</authorUrl>
    <version>3.0.0</version>
    <description>MOD_SIDEWIDGET_XML_DESCRIPTION</description>
    <files>
        <filename module="mod_sidewidget">mod_sidewidget.php</filename>
        <folder>language</folder>
        <folder>tmpl</folder>
        <filename>helper.php</filename>
    </files>
    <languages>
        <language tag="en-GB">language/en-GB/en-GB.mod_sidewidget.ini</language>
        <language tag="en-GB">language/en-GB/en-GB.mod_sidewidget.sys.ini</language>
        <language tag="vi-VN">language/vi-VN/vi-VN.mod_sidewidget.ini</language>
        <language tag="vi-VN">language/vi-VN/vi-VN.mod_sidewidget.sys.ini</language>
    </languages>
    <help key="JHELP_EXTENSIONS_MODULE_MANAGER_ENQUIRY" />
    <config>
        <fields name="params">
            <fieldset name="basic">
                
                <field
                    name="openenquiry"
                    type="radio"
                    label="MOD_SIDEWIDGET_FIELD_OPENENQUIRY_LABEL"
                    description="MOD_SIDEWIDGET_FIELD_OPENENQUIRY_DESC"
                    class="btn-group btn-group-yesno"
                    default="1"
                >
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>

                <field
                    name="openenquiry_title"
                    type="text"
                    class="span12"
                    label="MOD_SIDEWIDGET_FIELD_OPENENQUIRY_TEXT_LABEL"
                    description="MOD_SIDEWIDGET_FIELD_OPENENQUIRY_TEXT_DESC"
                    showon="openenquiry:1"
                />
                
                <field
                    name="pretext"
                    type="textarea"
                    label="MOD_AGENT_APP_FIELD_PRE_TEXT_LABEL"
                    description="MOD_AGENT_APP_FIELD_PRE_TEXT_DESC"
                    filter="safehtml"
                    cols="30"
                    rows="5"
                    class="span12"
                />
                
                
                <field
                    name="posttext"
                    type="textarea"
                    label="MOD_AGENT_APP_FIELD_POST_TEXT_LABEL"
                    description="MOD_AGENT_APP_FIELD_POST_TEXT_DESC"
                    filter="safehtml"
                    cols="30"
                    rows="5"
                    class="span12"
                />
                
                <field 
                    name="thumbnail" 
                    type="media"
                    class="span10"
                    label="MOD_AGENT_APP_THUMBNAIL_LABEL" 
                    description="MOD_AGENT_APP_THUMBNAIL_DESC" 
                />
                <field 
                    name="description" 
                    type="editor" 
                    label="MOD_AGENT_APP_DESCRIPTION_LABEL" 
                    description="MOD_AGENT_APP_DESCRIPTION_DESC" 
                    filter="JComponentHelper::filterText" 
                    buttons="true" 
                />
                <field
                    name="button"
                    type="radio"
                    label="MOD_SIDEWIDGET_FIELD_BUTTON_LABEL"
                    description="MOD_SIDEWIDGET_FIELD_BUTTON_DESC"
                    default="0"
                    class="btn-group btn-group-yesno"
                >
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>
                <field
                    name="button_pos"
                    type="list"
                    label="MOD_SIDEWIDGET_FIELD_BUTTONPOS_LABEL"
                    description="MOD_SIDEWIDGET_FIELD_BUTTONPOS_DESC"
                    default="left"
                    showon="button:1"
                >
                    <option value="right">MOD_SIDEWIDGET_FIELD_VALUE_RIGHT</option>
                    <option value="left">MOD_SIDEWIDGET_FIELD_VALUE_LEFT</option>
                    <option value="top">MOD_SIDEWIDGET_FIELD_VALUE_TOP</option>
                    <option value="bottom">MOD_SIDEWIDGET_FIELD_VALUE_BOTTOM</option>
                </field>

                <field
                    name="imagebutton"
                    type="radio"
                    label="MOD_SIDEWIDGET_FIELD_IMAGEBUTTON_LABEL"
                    description="MOD_SIDEWIDGET_FIELD_IMAGEBUTTON_DESC"
                    default="0"
                    class="btn-group btn-group-yesno"
                    showon="button:1"
                >
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>

                <field
                    name="button_text"
                    type="text"
                    label="MOD_SIDEWIDGET_FIELD_BUTTONTEXT_LABEL"
                    description="MOD_SIDEWIDGET_FIELD_BUTTONTEXT_DESC"
                    showon="button:1"
                />
                
                <field
                    name="closebutton"
                    type="radio"
                    label="MOD_SIDEWIDGET_FIELD_CLOSEBUTTON_LABEL"
                    description="MOD_SIDEWIDGET_FIELD_CLOSEBUTTON_DESC"
                    default="0"
                    class="btn-group btn-group-yesno"
                    showon="button:1"
                >
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>

                <field
                    name="closebutton_pos"
                    type="list"
                    label="MOD_SIDEWIDGET_FIELD_CLOSEBUTTONPOS_LABEL"
                    description="MOD_SIDEWIDGET_FIELD_CLOSEBUTTONPOS_DESC"
                    default="right"
                    showon="button:1[AND]closebutton:1"
                >
                    <option value="right">MOD_SIDEWIDGET_FIELD_VALUE_RIGHT</option>
                    <option value="left">MOD_SIDEWIDGET_FIELD_VALUE_LEFT</option>
                </field>
                
                <field
                    name="closebutton_text"
                    type="text"
                    label="MOD_SIDEWIDGET_FIELD_CLOSEBUTTONTEXT_LABEL"
                    description="MOD_SIDEWIDGET_FIELD_CLOSEBUTTONTEXT_DESC"
                    showon="button:1[AND]closebutton:1"
                />
                
                <field
                    name="anchor_css"
                    type="text"
                    label="MOD_SIDEWIDGET_FIELD_ANCHOR_CSS_LABEL"
                    description="MOD_SIDEWIDGET_FIELD_ANCHOR_CSS_DESC"
                    showon="button:1[AND]closebutton:1"
                />

                <field
                    name="spacer1"
                    type="spacer"
                    hr="true"
                    showon="button:1"
                />
                
                
                <!--
                <field
                    name="set_itemid"
                    type="menuitem"
                    label="MOD_SIDEWIDGET_FIELD_SETITEMID_LABEL"
                    description="MOD_SIDEWIDGET_FIELD_SETITEMID_DESC"
                    default="0"
                >
                    <option value="0">MOD_SIDEWIDGET_SELECT_MENU_ITEMID</option>
                </field>
                -->
            </fieldset>
            <fieldset name="advanced" addfieldpath="/administrator/components/com_standard/models/fields">
                <field
                    name="type_id"
                    type="SettingJsonType"
                    label="MOD_SIDEWIDGET_NEWS_FIELD_TYPE_LABEL"
                    description="MOD_SIDEWIDGET_NEWS_FIELD_TYPE_DESC"
                    default="*"
                >
                    <option value="*">JALL</option>
                </field>
                <field
                    name="layout"
                    type="modulelayout"
                    label="JFIELD_ALT_LAYOUT_LABEL"
                    description="JFIELD_ALT_MODULE_LAYOUT_DESC"
                />

                <field
                    name="moduleclass_sfx"
                    type="textarea"
                    label="COM_MODULES_FIELD_MODULECLASS_SFX_LABEL"
                    description="COM_MODULES_FIELD_MODULECLASS_SFX_DESC"
                    rows="3"
                />

                <field
                    name="cache"
                    type="list"
                    label="COM_MODULES_FIELD_CACHING_LABEL"
                    description="COM_MODULES_FIELD_CACHING_DESC"
                    default="1"
                >
                    <option value="1">JGLOBAL_USE_GLOBAL</option>
                    <option value="0">COM_MODULES_FIELD_VALUE_NOCACHING</option>
                </field>

                <field
                    name="cache_time"
                    type="text"
                    label="COM_MODULES_FIELD_CACHE_TIME_LABEL"
                    description="COM_MODULES_FIELD_CACHE_TIME_DESC"
                    default="900"
                />

                <field
                    name="cachemode"
                    type="hidden"
                    default="itemid"
                >
                    <option value="itemid"></option>
                </field>
            </fieldset>
        </fields>
    </config>
</extension>
