<?xml version="1.0" encoding="utf-8"?>
<extension type="module" version="3.1" client="site" method="upgrade">
    <name>mod_utilities</name>
    <author>Binh Nguyen! Project</author>
    <creationDate>January 2018</creationDate>
    <copyright>Copyright (C) 2005 - 2018 Open Source Matters. All rights reserved.</copyright>
    <license>GNU General Public License version 2 or later; see LICENSE.txt</license>
    <authorEmail>admin@giaiphapcongnghethongtin.vn</authorEmail>
    <authorUrl>www.giaiphapcongnghethongtin.vn</authorUrl>
    <version>3.0.0</version>
    <description>MOD_UTILITIES_XML_DESCRIPTION</description>
    <files>
        <filename>helper.php</filename>
        <filename module="mod_utilities">mod_utilities.php</filename>
        <folder>language</folder>
        <folder>tmpl</folder>
    </files>
    <!--
    <languages>
        <language tag="en-GB">language/en-GB/en-GB.mod_utilities.ini</language>
        <language tag="en-GB">language/en-GB/en-GB.mod_utilities.sys.ini</language>
        <language tag="vi-VN">language/vi-VN/vi-VN.mod_utilities.ini</language>
        <language tag="vi-VN">language/vi-VN/vi-VN.mod_utilities.sys.ini</language>
    </languages>
    -->
    <help key="JHELP_EXTENSIONS_MODULE_MANAGER_UTILITIES"/>
    <config>
        <fields name="params">
            <fieldset name="basic" addfieldpath="/administrator/components/com_menus/models/fields">
                <field
                    name="cart"
                    type="modal_menu"
                    label="MOD_UTILITIES_REDIRECTURL_LABEL"
                    description="MOD_UTILITIES_REDIRECTURL_DESC"
                    disable="separator,alias,heading,url"
                    select="true"
                    new="true"
                    edit="true"
                    clear="true"
                >
                    <option value="">JDEFAULT</option>
                </field>
                
                <field
                    name="show_popover"
                    type="radio"
                    label="MOD_UTILITIES_FIELD_SHOW_POPOVER_LABEL"
                    description="MOD_UTILITIES_FIELD_SHOW_POPOVER_DESC"
                    class="btn-group btn-group-yesno"
                    default="0"
                >
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>
                
            </fieldset>
            
            <fieldset name="advanced">
                <field
                    name="layout"
                    type="modulelayout"
                    label="JFIELD_ALT_LAYOUT_LABEL"
                    description="JFIELD_ALT_MODULE_LAYOUT_DESC"
                />
                <field
                    name="class_sfx"
                    type="textarea" rows="3"
                    label="MOD_UTILITIES_FIELD_CLASS_LABEL"
                    description="MOD_UTILITIES_FIELD_CLASS_DESC"
                />
                <field
                    name="moduleclass_sfx"
                    type="textarea" rows="3"
                    label="COM_MODULES_FIELD_MODULECLASS_SFX_LABEL"
                    description="COM_MODULES_FIELD_MODULECLASS_SFX_DESC"
                />

                <field
                    name="cache"
                    type="list"
                    label="COM_MODULES_FIELD_CACHING_LABEL"
                    description="COM_MODULES_FIELD_CACHING_DESC"
                    default="1"
                >
                    <option value="1">JGLOBAL_USE_GLOBAL</option>
                    <option value="0">COM_MODULES_FIELD_VALUE_NOCACHING</option>
                </field>

                <field
                    name="cache_time"
                    type="number"
                    label="COM_MODULES_FIELD_CACHE_TIME_LABEL"
                    description="COM_MODULES_FIELD_CACHE_TIME_DESC"
                    default="900"
                />
            </fieldset>
        </fields>
    </config>
</extension>
