<?xml version="1.0" encoding="utf-8"?>
<extension type="module" version="3.1" client="site" method="upgrade">
    <name>mod_products</name>
    <author>Binh Nguyen! Project</author>
    <creationDate>July 2006</creationDate>
    <copyright>Copyright (C) 2005 - 2019 Open Source Matters. All rights reserved.</copyright>
    <license>GNU General Public License version 2 or later; see LICENSE.txt</license>
    <authorEmail>admin@giaiphapcongnghethongtin.vn</authorEmail>
    <authorUrl>www.giaiphapcongnghethongtin.vn</authorUrl>
    <version>3.0.0</version>
    <description>MOD_PRODUCTS_XML_DESCRIPTION</description>
    <files>
        <folder>language</folder>
        <folder>tmpl</folder>
        <filename>helper.php</filename>
        <filename module="mod_products">mod_products.php</filename>
    </files>
    <!--
    <languages>
        <language tag="en-GB">language/en-GB/en-GB.mod_products.ini</language>
        <language tag="en-GB">language/en-GB/en-GB.mod_products.sys.ini</language>
        <language tag="vi-VN">language/vi-VN/vi-VN.mod_products.ini</language>
        <language tag="vi-VN">language/vi-VN/vi-VN.mod_products.sys.ini</language>
    </languages>
    -->
    <help key="JHELP_EXTENSIONS_MODULE_MANAGER_PRODUCTS"/>
    <config>
        <fields name="params">
            <fieldset name="basic" addfieldpath="/administrator/components/com_standard/models/fields">
                <field
                    name="subheading"
                    type="textarea"
                    class="span12"
                    rows="4"
                    label="MOD_PRODUCTS_FIELD_SUBHEADING_LABEL"
                    description="MOD_PRODUCTS_FIELD_SUBHEADING_DESC"
                />
                <field
                    name="catid"
                    type="categoryedit"
                    label="JCATEGORY"
                    description="MOD_PRODUCTS_FIELD_CATEGORY_DESC"
                    extension="com_standard"
                    multiple="true"
                    filter="int_array"
                    class="multipleCategories"
                />

                <field
                    name="tag"
                    type="tag"
                    label="JTAG"
                    description="JTAG_DESC"
                    mode="nested"
                    multiple="true"
                    filter="int_array"
                    class="multipleTags"
                />

                <field
                    name="image"
                    type="radio"
                    label="MOD_PRODUCTS_FIELD_IMAGES_LABEL"
                    description="MOD_PRODUCTS_FIELD_IMAGES_DESC"
                    class="btn-group btn-group-yesno"
                    default="0"
                    filter="integer"
                >
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>

                <field
                    name="img_intro_full"
                    type="list"
                    label="MOD_PRODUCTS_FIELD_IMAGES_ARTICLE_LABEL"
                    description="MOD_PRODUCTS_FIELD_IMAGES_ARTICLE_DESC"
                    default="none"
                >
                    <option value="intro">MOD_PRODUCTS_OPTION_INTROIMAGE</option> 
                    <option value="full">MOD_PRODUCTS_OPTION_FULLIMAGE</option>
                    <option value="none">JNO</option>
                </field>

                <field
                    name="item_title"
                    type="radio"
                    label="MOD_PRODUCTS_FIELD_TITLE_LABEL"
                    description="MOD_PRODUCTS_FIELD_TITLE_DESC"
                    class="btn-group btn-group-yesno"
                    default="0"
                    filter="integer"
                >
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>

                <field
                    name="link_titles"
                    type="list"
                    label="MOD_PRODUCTS_FIELD_LINKTITLE_LABEL"
                    description="MOD_PRODUCTS_FIELD_LINKTITLE_DESC"
                    default=""
                    filter="integer"
                    class="chzn-color"
                    showon="item_title:1"
                >
                    <option value="">JGLOBAL_USE_GLOBAL</option>
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>

                <field
                    name="item_heading"
                    type="list"
                    label="MOD_PRODUCTS_TITLE_HEADING"
                    description="MOD_PRODUCTS_TITLE_HEADING_DESCRIPTION"
                    default="h4"
                    showon="item_title:1"
                >
                    <option value="h1">JH1</option>
                    <option value="h2">JH2</option>
                    <option value="h3">JH3</option>
                    <option value="h4">JH4</option>
                    <option value="h5">JH5</option>
                </field>

                <field
                    name="item_header_class"
                    type="textarea" 
                    rows="2"
                    label="MOD_PRODUCTS_ITEM_HEADER_CLASS"
                    description="MOD_PRODUCTS_ITEM_HEADER_CLASS_DESCRIPTION"
                    default=""
                    showon="item_title:1"
                >
                </field>
                
                <field
                    name="triggerevents"
                    type="radio"
                    label="MOD_PRODUCTS_FIELD_TRIGGEREVENTS_LABEL"
                    description="MOD_PRODUCTS_FIELD_TRIGGEREVENTS_DESC"
                    class="btn-group btn-group-yesno"
                    default="1"
                    filter="integer"
                >
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>

                <field
                    name="showLastSeparator"
                    type="radio"
                    label="MOD_PRODUCTS_FIELD_SEPARATOR_LABEL"
                    description="MOD_PRODUCTS_FIELD_SEPARATOR_DESC"
                    class="btn-group btn-group-yesno"
                    default="1"
                    filter="integer"
                >
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>

                <field
                    name="show_introtext"
                    type="radio"
                    label="MOD_PRODUCTS_FIELD_SHOWINTROTEXT_LABEL"
                    description="MOD_PRODUCTS_FIELD_SHOWINTROTEXT_DESC"
                    default="1"
                    filter="integer"
                    class="btn-group btn-group-yesno"
                >
                    <option value="1">JSHOW</option>
                    <option value="0">JHIDE</option>
                </field>

                <field
                    name="booknow"
                    type="radio"
                    label="MOD_PRODUCTS_FIELD_BOOK_NOW_LABEL"
                    description="MOD_PRODUCTS_FIELD_BOOK_NOW_DESC"
                    class="btn-group btn-group-yesno"
                    default="0"
                    filter="integer"
                >
                    <option value="1">JSHOW</option>
                    <option value="0">JHIDE</option>
                </field>
                
                <field 
                    name="booknow_text"
                    type="text"
                    label="MOD_PRODUCTS_FIELD_BOOK_NOW_TEXT_LABEL"
                    description="MOD_PRODUCTS_FIELD_BOOK_NOW_TEXT_DESC"
                    default="Book now"
                    showon="booknow:1"
                />

                <field
                    name="readmore"
                    type="radio"
                    label="MOD_PRODUCTS_FIELD_READMORE_LABEL"
                    description="MOD_PRODUCTS_FIELD_READMORE_DESC"
                    class="btn-group btn-group-yesno"
                    default="0"
                    filter="integer"
                >
                    <option value="1">JSHOW</option>
                    <option value="0">JHIDE</option>
                </field>
                               
                <field 
                    name="readmore_linktext"
                    type="text"
                    label="MOD_PRODUCTS_FIELD_READMORE_LINK_TEXT_LABEL"
                    description="MOD_PRODUCTS_FIELD_READMORE_LINK_TEXT_DESC"
                    default="Learn more"
                    showon="readmore:1"
                />
                
                <field
                    name="layout_button"
                    type="list"
                    label="MOD_PRODUCTS_LAYOUT_BUTTON"
                    description="MOD_PRODUCTS_LAYOUT_BUTTON_DESCRIPTION"
                    default="h4"
                    showon="booknow:1[OR]readmore:1"
                >
                    <option value="horizontal">horizontal</option>
                    <option value="vertical">vertical</option>
                </field>
                
                <field
                    name="count"
                    type="number"
                    label="MOD_PRODUCTS_FIELD_ITEMS_LABEL"
                    description="MOD_PRODUCTS_FIELD_ITEMS_DESC"
                    default="5"
                    filter="integer"
                />

                <field
                    name="show_featured"
                    type="list"
                    label="MOD_PRODUCTS_FIELD_FEATURED_LABEL"
                    description="MOD_PRODUCTS_FIELD_FEATURED_DESC"
                    default=""
                    filter="integer"
                >
                    <option value="">JSHOW</option>
                    <option value="0">JHIDE</option>
                    <option value="1">MOD_PRODUCTS_VALUE_ONLY_SHOW_FEATURED</option>
                </field>

                <field
                    name="ordering"
                    type="list"
                    label="MOD_PRODUCTS_FIELD_ORDERING_LABEL"
                    description="MOD_PRODUCTS_FIELD_ORDERING_DESC"
                    default="p.publish_up"
                >
                    <option value="p.publish_up">MOD_PRODUCTS_FIELD_ORDERING_PUBLISHED_DATE</option>
                    <option value="p.created">MOD_PRODUCTS_FIELD_ORDERING_CREATED_DATE</option>
                    <option value="p.modified">MOD_PRODUCTS_FIELD_ORDERING_MODIFIED_DATE</option>
                    <option value="p.ordering">MOD_PRODUCTS_FIELD_ORDERING_ORDERING</option>
                    <option value="p.hits">JGLOBAL_HITS</option>
                    <option value="rand()">MOD_PRODUCTS_FIELD_ORDERING_RANDOM</option>
                </field>

                <field
                    name="direction"
                    type="list"
                    label="JGLOBAL_ORDER_DIRECTION_LABEL"
                    description="JGLOBAL_ORDER_DIRECTION_DESC"
                    default="1"
                    filter="integer"
                    showon="ordering:p.publish_up,p.created,p.modified,p.ordering,p.hits"
                >
                    <option value="0">JGLOBAL_ORDER_ASCENDING</option>
                    <option value="1">JGLOBAL_ORDER_DESCENDING</option>
                </field>
            </fieldset>

            <fieldset name="advanced">
                <field
                    name="layout"
                    type="modulelayout"
                    label="JFIELD_ALT_LAYOUT_LABEL"
                    description="JFIELD_ALT_MODULE_LAYOUT_DESC"
                />
                
                 <field
                    name="show_icon"
                    type="radio"
                    label="MOD_PRODUCTS_FIELD_SHOW_ICON_LABEL"
                    description="MOD_PRODUCTS_FIELD_SHOW_ICON_DESC"
                    class="btn-group btn-group-yesno"
                    default="0"
                >
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>
                
                <field
                    name="position_icon_top"
                    type="list"
                    description="MOD_PRODUCTS_FIELD_POSITION_ICON_TOP_DESC"
                    label="MOD_PRODUCTS_FIELD_POSITION_ICON_TOP_LABEL"
                    useglobal="true"
                    showon="show_icon:1"
                >
                    <option value="left-top">GLOBAL_LEFT_TOP</option>
                    <option value="right-top">GLOBAL_RIGHT_TOP</option>
                </field>
                
                <field
                    name="position_icon_bottom"
                    type="list"
                    description="MOD_PRODUCTS_FIELD_POSITION_ICON_BOTTOM_DESC"
                    label="MOD_PRODUCTS_FIELD_POSITION_ICON_BOTTOM_LABEL"
                    useglobal="true"
                    showon="show_icon:1"
                >
                    <option value="left-bottom">GLOBAL_LEFT_BOTTOM</option>
                    <option value="right-bottom">GLOBAL_RIGHT_BOTTOM</option>
                </field>
                
                <field
                    name="class_subheading"
                    type="text"
                    class="span6"
                    label="MOD_PRODUCTS_FIELD_CLASS_SUBHEADING_LABEL"
                    description="MOD_PRODUCTS_FIELD_CLASS_SUBHEADING_DESC"
                />
                
                <field 
                    name="subheading_medialayoutelement"
                    type="LayoutElement"
                    class="span6"
                    label="GLOBAL_SUBHEADING_LAYOUT_ELEMENT_LABEL"
                    description="GLOBAL_SUBHEADING_LAYOUT_ELEMENT_DESC"
                    default="using-max-width-sm"
                >
                    <option value=" ">JGLOBAL_USE_GLOBAL</option>
                </field>
                
                <field 
                    name="leading_medialayoutelement"
                    type="LayoutElement"
                    class="span6"
                    label="GLOBAL_LEADING_LAYOUT_ELEMENT_LABEL"
                    description="GLOBAL_LEADING_LAYOUT_ELEMENT_DESC"
                    default=" "
                >
                    <option value=" ">JGLOBAL_USE_GLOBAL</option>
                </field>
                
                <field 
                    name="intro_medialayoutelement"
                    type="LayoutElement"
                    class="span6"
                    label="GLOBAL_INTRO_LAYOUT_ELEMENT_LABEL"
                    description="GLOBAL_INTRO_LAYOUT_ELEMENT_DESC"
                    default=" "
                >
                    <option value=" ">JGLOBAL_USE_GLOBAL</option>
                </field>
                
                <field
                    name="num_leading"
                    type="text"
                    description="JGLOBAL_NUM_LEADING_PRODUCTS_DESC"
                    label="JGLOBAL_NUM_LEADING_PRODUCTS_LABEL"
                    useglobal="true"
                />

                <field
                    name="num_intro"
                    type="text"
                    description="JGLOBAL_NUM_INTRO_PRODUCTS_DESC"
                    label="JGLOBAL_NUM_INTRO_PRODUCTS_LABEL"
                    useglobal="true"
                />

                <field
                    name="num_columns_leading"
                    type="text"
                    description="GLOBAL_NUM_COLUMNS_LEADING_DESC"
                    label="GLOBAL_NUM_COLUMNS_LEADING_LABEL"
                    useglobal="true"
                />
                <field
                    name="num_columns_intro"
                    type="text"
                    description="GLOBAL_NUM_COLUMNS_INTRO_DESC"
                    label="GLOBAL_NUM_COLUMNS_INTRO_LABEL"
                    useglobal="true"
                />

                <field
                    name="num_links"
                    type="text"
                    description="JGLOBAL_NUM_LINKS_DESC"
                    label="JGLOBAL_NUM_LINKS_LABEL"
                    useglobal="true"
                />

                <field
                    name="multi_column_order"
                    type="list"
                    description="JGLOBAL_MULTI_COLUMN_ORDER_DESC"
                    label="JGLOBAL_MULTI_COLUMN_ORDER_LABEL"
                    useglobal="true"
                >
                    <option value="0">JGLOBAL_DOWN</option>
                    <option value="1">JGLOBAL_ACROSS</option>
                </field>

                <field
                    name="class_sfx"
                    type="textarea" rows="3"
                    label="MOD_PRODUCTS_FIELD_CLASS_LABEL"
                    description="MOD_PRODUCTS_FIELD_CLASS_DESC"
                />
                
                <field
                    name="anchor_css"
                    type="text"
                    label="MOD_PRODUCTS_FIELD_ANCHOR_CSS_LABEL"
                    description="MOD_PRODUCTS_FIELD_ANCHOR_CSS_DESC"
                />

                <field
                    name="moduleclass_sfx"
                    type="textarea"
                    label="COM_MODULES_FIELD_MODULECLASS_SFX_LABEL"
                    description="COM_MODULES_FIELD_MODULECLASS_SFX_DESC"
                    rows="3"
                />

                <field
                    name="cache"
                    type="list"
                    label="COM_MODULES_FIELD_CACHING_LABEL"
                    description="COM_MODULES_FIELD_CACHING_DESC"
                    default="1"
                    filter="integer"
                >
                    <option value="1">JGLOBAL_USE_GLOBAL</option>
                    <option value="0">COM_MODULES_FIELD_VALUE_NOCACHING</option>
                </field>

                <field
                    name="cache_time"
                    type="number"
                    label="COM_MODULES_FIELD_CACHE_TIME_LABEL"
                    description="COM_MODULES_FIELD_CACHE_TIME_DESC"
                    default="900"
                    filter="integer"
                />

                <field
                    name="cachemode"
                    type="hidden"
                    default="itemid"
                >
                    <option value="itemid"></option>
                </field>
            </fieldset>
        </fields>
    </config>
</extension>
