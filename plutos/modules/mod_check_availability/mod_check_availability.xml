<?xml version="1.0" encoding="utf-8"?>
<extension type="module" version="3.1" client="site" method="upgrade">
    <name>mod_check_availability</name>
    <author>Binh Nguyen! Project</author>
    <creationDate>May 2007</creationDate>
    <copyright>Copyright (C) 2005 - 2017 Open Source Matters. All rights reserved.</copyright>
    <license>GNU General Public License version 2 or later; see LICENSE.txt</license>
    <authorEmail>admin@giaiphapcongnghethongtin.vn</authorEmail>
    <authorUrl>www.giaiphapcongnghethongtin.vn</authorUrl>
    <version>3.0.0</version>
    <description>MOD_CHECK_AVAILABILITY_XML_DESCRIPTION</description>
    <files>
        <filename module="mod_check_availability">mod_check_availability.php</filename>
        <folder>language</folder>
        <folder>tmpl</folder>
        <filename>helper.php</filename>
    </files>
    <languages>
        <language tag="en-GB">language/en-GB/en-GB.mod_check_availability.ini</language>
        <language tag="en-GB">language/en-GB/en-GB.mod_check_availability.sys.ini</language>
        <language tag="vi-VN">language/vi-VN/vi-VN.mod_check_availability.ini</language>
        <language tag="vi-VN">language/vi-VN/vi-VN.mod_check_availability.sys.ini</language>
    </languages>
    <help key="JHELP_EXTENSIONS_MODULE_MANAGER_SEARCH" />
    <config>
        <fields name="params">
            <fieldset name="basic">
                <field
                    name="label"
                    type="label"
                    label="MOD_CHECK_AVAILABILITY_FIELD_LABEL_TEXT_LABEL"
                    description="MOD_CHECK_AVAILABILITY_FIELD_LABEL_TEXT_DESC"
                />

                <field
                    name="width"
                    type="text"
                    label="MOD_CHECK_AVAILABILITY_FIELD_BOXWIDTH_LABEL"
                    description="MOD_CHECK_AVAILABILITY_FIELD_BOXWIDTH_DESC"
                />

                <field
                    name="text"
                    type="text"
                    label="MOD_CHECK_AVAILABILITY_FIELD_TEXT_LABEL"
                    description="MOD_CHECK_AVAILABILITY_FIELD_TEXT_DESC"
                />

                <field
                    name="button"
                    type="radio"
                    label="MOD_CHECK_AVAILABILITY_FIELD_BUTTON_LABEL"
                    description="MOD_CHECK_AVAILABILITY_FIELD_BUTTON_DESC"
                    default="0"
                    class="btn-group btn-group-yesno"
                >
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>
                <field
                    name="button_pos"
                    type="list"
                    label="MOD_CHECK_AVAILABILITY_FIELD_BUTTONPOS_LABEL"
                    description="MOD_CHECK_AVAILABILITY_FIELD_BUTTONPOS_DESC"
                    default="left"
                    showon="button:1"
                >
                    <option value="right">MOD_CHECK_AVAILABILITY_FIELD_VALUE_RIGHT</option>
                    <option value="left">MOD_CHECK_AVAILABILITY_FIELD_VALUE_LEFT</option>
                    <option value="top">MOD_CHECK_AVAILABILITY_FIELD_VALUE_TOP</option>
                    <option value="bottom">MOD_CHECK_AVAILABILITY_FIELD_VALUE_BOTTOM</option>
                </field>

                <field
                    name="imagebutton"
                    type="radio"
                    label="MOD_CHECK_AVAILABILITY_FIELD_IMAGEBUTTON_LABEL"
                    description="MOD_CHECK_AVAILABILITY_FIELD_IMAGEBUTTON_DESC"
                    default="0"
                    class="btn-group btn-group-yesno"
                    showon="button:1"
                >
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>

                <field
                    name="button_text"
                    type="text"
                    label="MOD_CHECK_AVAILABILITY_FIELD_BUTTONTEXT_LABEL"
                    description="MOD_CHECK_AVAILABILITY_FIELD_BUTTONTEXT_DESC"
                    showon="button:1"
                />

                <field name="linktarget" 
                       type="list" 
                       label="MOD_CHECK_AVAILABILITY_LINK_TARGET"
                       description="MOD_CHECK_AVAILABILITY_LINK_TARGET_DESC" 
                       default=""
                >
                    <option value="">MOD_CHECK_AVAILABILITY_AUTO</option>
                    <option value="_self">MOD_CHECK_AVAILABILITY_PARENT_WINDOW</option>
                    <option value="_blank">MOD_CHECK_AVAILABILITY_NEW_WINDOW</option>
                </field>
        
                <field
                    name="opensearch"
                    type="radio"
                    label="MOD_CHECK_AVAILABILITY_FIELD_OPENSEARCH_LABEL"
                    description="MOD_CHECK_AVAILABILITY_FIELD_OPENSEARCH_DESC"
                    class="btn-group btn-group-yesno"
                    default="1"
                >
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>

                <field
                    name="opensearch_title"
                    type="text"
                    label="MOD_CHECK_AVAILABILITY_FIELD_OPENSEARCH_TEXT_LABEL"
                    description="MOD_CHECK_AVAILABILITY_FIELD_OPENSEARCH_TEXT_DESC"
                    showon="opensearch:1"
                />

                <field
                    name="set_itemid"
                    type="menuitem"
                    label="MOD_CHECK_AVAILABILITY_FIELD_SETITEMID_LABEL"
                    description="MOD_CHECK_AVAILABILITY_FIELD_SETITEMID_DESC"
                    default="0"
                >
                    <option value="0">MOD_CHECK_AVAILABILITY_SELECT_MENU_ITEMID</option>
                </field>
            </fieldset>
            <fieldset name="advanced">
                <field
                    name="layout"
                    type="modulelayout"
                    label="JFIELD_ALT_LAYOUT_LABEL"
                    description="JFIELD_ALT_MODULE_LAYOUT_DESC"
                />
                
                <field
                    name="class_sfx"
                    type="textarea" rows="3"
                    label="MOD_CHECK_AVAILABILITY_FIELD_CLASS_LABEL"
                    description="MOD_CHECK_AVAILABILITY_FIELD_CLASS_DESC"
                />
                
                <field
                    name="anchor_css"
                    type="text"
                    label="MOD_CHECK_AVAILABILITY_FIELD_ANCHOR_CSS_LABEL"
                    description="MOD_CHECK_AVAILABILITY_FIELD_ANCHOR_CSS_DESC"
                />
                
                <field
                    name="moduleclass_sfx"
                    type="textarea"
                    label="COM_MODULES_FIELD_MODULECLASS_SFX_LABEL"
                    description="COM_MODULES_FIELD_MODULECLASS_SFX_DESC"
                    rows="3"
                />

                <field
                    name="cache"
                    type="list"
                    label="COM_MODULES_FIELD_CACHING_LABEL"
                    description="COM_MODULES_FIELD_CACHING_DESC"
                    default="1"
                >
                    <option value="1">JGLOBAL_USE_GLOBAL</option>
                    <option value="0">COM_MODULES_FIELD_VALUE_NOCACHING</option>
                </field>

                <field
                    name="cache_time"
                    type="text"
                    label="COM_MODULES_FIELD_CACHE_TIME_LABEL"
                    description="COM_MODULES_FIELD_CACHE_TIME_DESC"
                    default="900"
                />

                <field
                    name="cachemode"
                    type="hidden"
                    default="itemid"
                >
                    <option value="itemid"></option>
                </field>
            </fieldset>
        </fields>
    </config>
</extension>
