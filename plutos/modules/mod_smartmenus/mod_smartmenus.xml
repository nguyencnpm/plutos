<?xml version="1.0" encoding="utf-8"?>
<extension type="module" version="3.1" client="site" method="upgrade">
    <name>mod_smartmenus</name>
    <author>Binh Nguyen! Project</author>
    <creationDate>July 2004</creationDate>
    <copyright>Copyright (C) 2005 - 2019 Open Source Matters. All rights reserved.</copyright>
    <license>GNU General Public License version 2 or later; see LICENSE.txt</license>
    <authorEmail>admin@giaiphapcongnghethongtin.vn</authorEmail>
    <authorUrl>www.giaiphapcongnghethongtin.vn</authorUrl>
    <version>3.0.0</version>
    <description>MOD_SMARTMENUS_XML_DESCRIPTION</description>
    <files>
        <folder>language</folder>
        <folder>tmpl</folder>
        <filename>helper.php</filename>
        <filename module="mod_smartmenus">mod_smartmenus.php</filename>
    </files>
    <!--
    <languages>
        <language tag="en-GB">language/en-GB/en-GB.mod_smartmenus.ini</language>
        <language tag="en-GB">language/en-GB/en-GB.mod_smartmenus.sys.ini</language>
        <language tag="vi-VN">language/vi-VN/vi-VN.mod_smartmenus.ini</language>
        <language tag="vi-VN">language/vi-VN/vi-VN.mod_smartmenus.sys.ini</language>
    </languages>
    -->
    <help key="JHELP_EXTENSIONS_MODULE_MANAGER_MENU" />
    <config>
        <fields name="params">
            <fieldset name="basic" addfieldpath="/administrator/components/com_menus/models/fields">
                <field
                    name="menutype"
                    type="menu"
                    label="MOD_SMARTMENUS_FIELD_MENUTYPE_LABEL"
                    description="MOD_SMARTMENUS_FIELD_MENUTYPE_DESC"
                    clientid="0"
                />

                <field
                    name="base"
                    type="modal_menu"
                    label="MOD_SMARTMENUS_FIELD_ACTIVE_LABEL"
                    description="MOD_SMARTMENUS_FIELD_ACTIVE_DESC"
                    select="true"
                    new="true"
                    edit="true"
                    clear="true"
                    filter="integer"
                >
                    <option value="">JCURRENT</option>
                </field>

                <field
                    name="startLevel"
                    type="list"
                    label="MOD_SMARTMENUS_FIELD_STARTLEVEL_LABEL"
                    description="MOD_SMARTMENUS_FIELD_STARTLEVEL_DESC"
                    default="1"
                    filter="integer"
                >
                    <option value="1">J1</option>
                    <option value="2">J2</option>
                    <option value="3">J3</option>
                    <option value="4">J4</option>
                    <option value="5">J5</option>
                    <option value="6">J6</option>
                    <option value="7">J7</option>
                    <option value="8">J8</option>
                    <option value="9">J9</option>
                    <option value="10">J10</option>
                </field>

                <field
                    name="endLevel"
                    type="list"
                    label="MOD_SMARTMENUS_FIELD_ENDLEVEL_LABEL"
                    description="MOD_SMARTMENUS_FIELD_ENDLEVEL_DESC"
                    default="0"
                    filter="integer"
                >
                    <option value="0">JALL</option>
                    <option value="1">J1</option>
                    <option value="2">J2</option>
                    <option value="3">J3</option>
                    <option value="4">J4</option>
                    <option value="5">J5</option>
                    <option value="6">J6</option>
                    <option value="7">J7</option>
                    <option value="8">J8</option>
                    <option value="9">J9</option>
                    <option value="10">J10</option>
                </field>

                <field
                    name="showAllChildren"
                    type="radio"
                    label="MOD_SMARTMENUS_FIELD_ALLCHILDREN_LABEL"
                    description="MOD_SMARTMENUS_FIELD_ALLCHILDREN_DESC"
                    class="btn-group btn-group-yesno"
                    default="1"
                    filter="integer"
                >
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>
                
                <field
                    name="menu_show_hidden"
                    type="list"
                    label="MOD_SMARTMENUS_ITEM_FIELD_MENU_SHOW_HIDDEN_LABEL"
                    description="MOD_SMARTMENUS_ITEM_FIELD_MENU_SHOW_HIDDEN_DESC"
                    class="chzn-color-state"
                    default="0"
                    filter="integer"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                    <option value="2">MOD_SMARTMENUS_VALUE_ONLY_SHOW_HIDDEN</option>
                </field>
                <field
                    name="menu_show_image"
                    type="radio"
                    label="MOD_SMARTMENUS_ITEM_FIELD_MENU_IMAGE_LABEL"
                    description="MOD_SMARTMENUS_ITEM_FIELD_MENU_IMAGE_DESC"
                    class="btn-group btn-group-yesno"
                    default="0"
                    filter="integer"
                >
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>
            </fieldset>

            <fieldset name="advanced">
                <field
                    name="subtitle"
                    type="text"
                    class="span8"
                    label="MOD_SMARTMENUS_FIELD_SUBTITLE_LABEL"
                    description="MOD_SMARTMENUS_FIELD_SUBTITLE_DESC"
                />
                
                <field
                    name="subtitle_class"
                    type="text"
                    label="MOD_SMARTMENUS_FIELD_SUBTITLE_CLASS_LABEL"
                    description="MOD_SMARTMENUS_FIELD_CLASS_DESC"
                />
                
                <field
                    name="tag_id"
                    type="text"
                    label="MOD_SMARTMENUS_FIELD_TAG_ID_LABEL"
                    description="MOD_SMARTMENUS_FIELD_TAG_ID_DESC"
                />

                <field
                    name="class_sfx"
                    type="text"
                    label="MOD_SMARTMENUS_FIELD_CLASS_LABEL"
                    description="MOD_SMARTMENUS_FIELD_CLASS_DESC"
                />
                
                <field
                    name="justify_content"
                    type="list"
                    label="MOD_SMARTMENUS_FIELD_JUSTIFY_CONTENT_LABEL"
                    description="MOD_SMARTMENUS_FIELD_JUSTIFY_CONTENT_DESC"
                    default=""
                >
                    <option value="">JGLOBAL_USE_GLOBAL</option>
                    
                    <option value="d-flex justify-content-start">Start</option>
                    <option value="d-flex justify-content-end">End</option>
                    <option value="d-flex justify-content-center">Center</option>
                    <option value="d-flex justify-content-between">Between</option>
                    <option value="d-flex justify-content-around">Around</option>
                    
                    <option value="d-flex justify-content-sm-start">Small Start</option>
                    <option value="d-flex justify-content-sm-end">Small End</option>
                    <option value="d-flex justify-content-sm-center">Small Center</option>
                    <option value="d-flex justify-content-sm-between">Small Between</option>
                    <option value="d-flex justify-content-sm-around">Small Around</option>
                    
                    <option value="d-flex justify-content-md-start">Medium Start</option>
                    <option value="d-flex justify-content-md-end">Medium End</option>
                    <option value="d-flex justify-content-md-center">Medium Center</option>
                    <option value="d-flex justify-content-md-between">Medium Between</option>
                    <option value="d-flex justify-content-md-around">Medium Around</option>
                    
                    <option value="d-flex justify-content-lg-start">Large Start</option>
                    <option value="d-flex justify-content-lg-end">Large End</option>
                    <option value="d-flex justify-content-lg-center">Large Center</option>
                    <option value="d-flex justify-content-lg-between">Large Between</option>
                    <option value="d-flex justify-content-lg-around">Large Around</option>
                    
                    <option value="d-flex justify-content-xl-start">Extra large Start</option>
                    <option value="d-flex justify-content-xl-end">Extra large End</option>
                    <option value="d-flex justify-content-xl-center">Extra large Center</option>
                    <option value="d-flex justify-content-xl-between">Extra large Between</option>
                    <option value="d-flex justify-content-xl-around">Extra large Around</option>
                </field>

                <field
                    name="direction"
                    type="list"
                    label="MOD_SMARTMENUS_FIELD_DIRECTION_LABEL"
                    description="MOD_SMARTMENUS_FIELD_DIRECTION_DESC"
                    default=""
                >
                    <option value="">JGLOBAL_USE_GLOBAL</option>
                    <option value="sm-ltr">DIRECTION_LTR</option>
                    <option value="sm-rtl">DIRECTION_RTL</option>
                </field>
                
                
                <field
                    name="window_open"
                    type="text"
                    label="MOD_SMARTMENUS_FIELD_TARGET_LABEL"
                    description="MOD_SMARTMENUS_FIELD_TARGET_DESC"
                />

                <field
                    name="layout"
                    type="modulelayout"
                    label="JFIELD_ALT_LAYOUT_LABEL"
                    description="JFIELD_ALT_MODULE_LAYOUT_DESC"
                />

                <field
                    name="moduleclass_sfx"
                    type="textarea"
                    label="COM_MODULES_FIELD_MODULECLASS_SFX_LABEL"
                    description="COM_MODULES_FIELD_MODULECLASS_SFX_DESC"
                    rows="3"
                />

                <field
                    name="cache"
                    type="list"
                    label="COM_MODULES_FIELD_CACHING_LABEL"
                    description="COM_MODULES_FIELD_CACHING_DESC"
                    default="1"
                    filter="integer"
                >
                    <option value="1">JGLOBAL_USE_GLOBAL</option>
                    <option value="0">COM_MODULES_FIELD_VALUE_NOCACHING</option>
                </field>

                <field
                    name="cache_time"
                    type="number"
                    label="COM_MODULES_FIELD_CACHE_TIME_LABEL"
                    description="COM_MODULES_FIELD_CACHE_TIME_DESC"
                    default="900"
                    filter="integer"
                />

                <field
                    name="cachemode"
                    type="hidden"
                    default="itemid"
                >
                    <option value="itemid"></option>
                </field>
            </fieldset>
        </fields>
    </config>
</extension>
