<?xml version="1.0" encoding="UTF-8"?>
<extension
    type="module"
    version="3.1"
    client="site"
    method="upgrade">
    <name>MOD_MARQUEE</name>
    <author>Nguyen Binh Nguyen</author>
    <creationDate>27 March 2014</creationDate>
    <copyright>Copyright (C) 2005 - 2014 Open Source Matters. All rights reserved.</copyright>
    <license>GNU General Public License version 2 or later; see LICENSE.txt</license>
    <authorEmail>nguyencnpm@gmail.com</authorEmail>
    <authorUrl>http://giaiphapcongnghethongtin.vn/</authorUrl>
    <version>3.0.0</version>
    <description>MOD_MARQUEE_XML_DESCRIPTION</description>
    <files>
        <filename module="mod_marquee">mod_marquee.php</filename>
        <folder>language</folder>
        <folder>tmpl</folder>
        <filename>helper.php</filename>
        <filename>index.html</filename>
        <filename>mod_marquee.xml</filename>
    </files>
    <languages>
        <language tag="en-GB">language/en-GB/en-GB.mod_marquee.ini</language>
        <language tag="en-GB">language/en-GB/en-GB.mod_marquee.sys.ini</language>
        <language tag="vi-VN">language/vi-VN/vi-VN.mod_marquee.ini</language>
        <language tag="vi-VN">language/vi-VN/vi-VN.mod_marquee.sys.ini</language>
    </languages>
    <help key="JHELP_EXTENSIONS_MODULE_MANAGER_MARQUEE" />
    <config>
        <fields name="params">
            <fieldset name="basic"
                      addfieldpath="/administrator/components/com_book_now/models/fields">
                <field
                    name="target"
                    type="list"
                    default="1"
                    label="MOD_MARQUEE_FIELD_TARGET_LABEL"
                    description="MOD_MARQUEE_FIELD_TARGET_DESC">
                    <option
                        value="0">JBROWSERTARGET_PARENT</option>
                    <option
                        value="1">JBROWSERTARGET_NEW</option>
                    <option
                        value="2">JBROWSERTARGET_POPUP</option>
                </field> 
                
                <field type="spacer" label="&lt;hr &#47;&gt;" />
                
                <field name="description" 
                       type="editor" 
                       label="Description" 
                       description="Description" 
                       filter="JComponentHelper::filterText" 
                       buttons="true" />
                
                <field name="description_tablet" 
                       type="editor" 
                       label="Description tablet" 
                       description="Description tablet" 
                       filter="JComponentHelper::filterText" 
                       buttons="true" />
                
                <field name="description_phone" 
                       type="editor" 
                       label="Description phone" 
                       description="Description phone" 
                       filter="JComponentHelper::filterText" 
                       buttons="true" />
                
                
                <field name="run"
                       type="radio"
                       class="btn-group btn-group-yesno"
                       default="1"
                       label="MOD_MARQUEE_RUN"
                >
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>
                <field name="align" type="list" default="" 
                       label="MOD_MARQUEE_ALIGN_LABEL" description="MOD_MARQUEE_ALIGN_DESC"
                >
                    <option value="">Use Global</option>
                    <option value="right">Right</option>
                    <option value="center">Center</option>
                    <option value="left">Left</option>
                    <option value="none">None</option>
                </field>


                <field name="behavior" type="list" default="" 
                       label="MOD_MARQUEE_BEHAVIOR" description="MOD_MARQUEE_BEHAVIOR_DESC"
                       showon="run:1"
                >
                    <option value="">MOD_MARQUEE_SELECT</option>
                    <option value="scroll">MOD_MARQUEE_BEHAVIOR_SCROLL</option>
                    <option value="slide">MOD_MARQUEE_BEHAVIOR_SLIDE</option>
                    <option value="alternate">MOD_MARQUEE_BEHAVIOR_ALTERNATE</option>
                </field>
                
                <field name="bgcolor" type="text" default="" size="10" label="MOD_MARQUEE_BGCOLOR" description="MOD_MARQUEE_BGCOLOR_DESC" />
                
                <field name="direction" type="list" default="" 
                       label="MOD_MARQUEE_DIRECTION" description="MOD_MARQUEE_DIRECTION_DESC"
                       showon="run:1"
                >
                    <option value="">MOD_MARQUEE_SELECT</option>
                    <option value="up">MOD_MARQUEE_DIRECTION_UP</option>
                    <option value="down">MOD_MARQUEE_DIRECTION_DOWN</option>
                    <option value="left">MOD_MARQUEE_DIRECTION_LEFT </option>
                    <option value="right">MOD_MARQUEE_DIRECTION_RIGHT</option>
                </field>
                
                <field name="height" type="text" default="100%" size="10" label="MOD_MARQUEE_HEIGHT" description="MOD_MARQUEE_HEIGHT_DESC" />
                <field name="hspace" type="text" default="" size="10" 
                       label="MOD_MARQUEE_HSPACE" description="MOD_MARQUEE_HSPACE_DESC" 
                       showon="run:1"
                />
                
                <field name="width" type="text" default="100%" size="10" label="MOD_MARQUEE_WIDTH" description="MOD_MARQUEE_WIDTH_DESC" />
                <field name="vspace" type="text" default="" size="10" 
                       label="MOD_MARQUEE_VSPACE" description="MOD_MARQUEE_VSPACE_DESC" 
                       showon="run:1"
                />
                
                <field name="loop" type="text" default="" size="10" 
                       label="MOD_MARQUEE_LOOP" description="MOD_MARQUEE_LOOP_DESC" 
                       showon="run:1"
                />

                <field name="scrolldelay" type="text" default="1" size="10" 
                       label="MOD_MARQUEE_SCROLLDELAY" description="MOD_MARQUEE_SCROLLDELAY_DESC"
                       showon="run:1"
                />
                <field name="scrollamount" type="text" default="5" size="10" 
                       label="MOD_MARQUEE_SCROLLAMOUNT" description="MOD_MARQUEE_SCROLLAMOUNT_DESC" 
                       showon="run:1"
                />
            
            </fieldset>
            <fieldset
                name="advanced">
                <field
                    name="layout"
                    type="modulelayout"
                    label="JFIELD_ALT_LAYOUT_LABEL"
                    description="JFIELD_ALT_MODULE_LAYOUT_DESC" />

                <field
                    name="class_sfx"
                    type="text"
                    label="MOD_FILTERPRODUCT_FIELD_CLASS_LABEL"
                    description="MOD_FILTERPRODUCT_FIELD_CLASS_DESC"
                />
                
                <field
                    name="moduleclass_sfx"
                    type="textarea" rows="3"
                    label="COM_MODULES_FIELD_MODULECLASS_SFX_LABEL"
                    description="COM_MODULES_FIELD_MODULECLASS_SFX_DESC" />

                <field
                    name="cache"
                    type="list"
                    default="1"
                    label="COM_MODULES_FIELD_CACHING_LABEL"
                    description="COM_MODULES_FIELD_CACHING_DESC">
                    <option
                        value="1">JGLOBAL_USE_GLOBAL</option>
                    <option
                        value="0">COM_MODULES_FIELD_VALUE_NOCACHING</option>
                </field>

                <field
                    name="cache_time"
                    type="text"
                    default="900"
                    label="COM_MODULES_FIELD_CACHE_TIME_LABEL"
                    description="COM_MODULES_FIELD_CACHE_TIME_DESC" />
            </fieldset>
        </fields>
    </config>
</extension>
