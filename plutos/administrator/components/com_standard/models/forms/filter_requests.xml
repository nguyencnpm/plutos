<?xml version="1.0" encoding="utf-8"?>
<form>
    <fields name="filter">
        <field
            name="search"
            type="text"
            label="COM_STANDARD_FILTER_SEARCH_LABEL"
            description="COM_STANDARD_FILTER_SEARCH_DESC"
            hint="JSEARCH_FILTER"
        />

        <field
            name="requestDate" 
            class="request-date"
            type="daterangepicker"
            label="COM_STANDARD_FILTER_REQUEST_DATE_LABEL"
            description="COM_STANDARD_FILTER_REQUEST_DATE_DESC"
            hint="REQUEST_DATE_RANGE_FILTER"
            onchange="this.form.submit();"
            default=""
            readonly="true"
        />

        <field
            name="published"
            type="StatusOrder"
            label="Status"
            description="Status"
            onchange="this.form.submit();"
        >
            <option value="">JOPTION_SELECT_PUBLISHED</option>
        </field>
        
        <field
            name="language"
            type="contentlanguage"
            label="JOPTION_FILTER_LANGUAGE"
            description="JOPTION_FILTER_LANGUAGE_DESC"
            onchange="this.form.submit();"
        >
            <option value="">JOPTION_SELECT_LANGUAGE</option>
            <option value="*">JALL</option>
        </field>
        
       
    </fields>
    <fields name="list">
        <field
            name="fullordering"
            type="list"
            label="COM_STANDARD_LIST_FULL_ORDERING"
            description="COM_STANDARD_LIST_FULL_ORDERING_DESC"
            onchange="this.form.submit();"
            default="r.id DESC"
        >
            <option value="">JGLOBAL_SORT_BY</option>
            <option value="r.ordering ASC">JGRID_HEADING_ORDERING_ASC</option>
            <option value="r.ordering DESC">JGRID_HEADING_ORDERING_DESC</option>
            <option value="r.state ASC">JSTATUS_ASC</option>
            <option value="r.state DESC">JSTATUS_DESC</option>
            <option value="r.contact_name ASC">COM_STANDARD_CONTACT_NAME_ASC</option>
            <option value="r.contact_name DESC">COM_STANDARD_CONTACT_NAME_DESC</option>
            <option value="r.access ASC">JGRID_HEADING_ACCESS_ASC</option>
            <option value="r.access DESC">JGRID_HEADING_ACCESS_DESC</option>
            <option value="r.created_by ASC">JAUTHOR_ASC</option>
            <option value="r.created_by DESC">JAUTHOR_DESC</option>
            <option value="language ASC">JGRID_HEADING_LANGUAGE_ASC</option>
            <option value="language DESC">JGRID_HEADING_LANGUAGE_DESC</option>
            <option value="r.created ASC">JDATE_ASC</option>
            <option value="r.created DESC">JDATE_DESC</option>
            <option value="r.modified ASC">COM_STANDARD_MODIFIED_ASC</option>
            <option value="r.modified DESC">COM_STANDARD_MODIFIED_DESC</option>
            
            <option value="r.ip_address ASC">COM_STANDARD_IP_ADDRESS_ASC</option>
            <option value="r.ip_address DESC">COM_STANDARD_IP_ADDRESS_DESC</option>
            
            <option value="r.device ASC">COM_STANDARD_DEVICES_ASC</option>
            <option value="r.device DESC">COM_STANDARD_DEVICES_DESC</option>
            
            <option value="r.browser ASC">COM_STANDARD_BROWSER_ASC</option>
            <option value="r.browser DESC">COM_STANDARD_BROWSER_DESC</option>
            
            <option value="r.id ASC">JGRID_HEADING_ID_ASC</option>
            <option value="r.id DESC">JGRID_HEADING_ID_DESC</option>
        </field>
        <field
            name="limit"
            type="limitbox"
            class="input-mini"
            default="25"
            label="COM_STANDARD_LIST_LIMIT"
            description="COM_STANDARD_LIST_LIMIT_DESC"
            onchange="this.form.submit();"
        />
    </fields>
</form>
