<?xml version="1.0" encoding="utf-8"?>
<form>
    <fieldset>
        <field name="id"  type="text" class="readonly" label="JGLOBAL_FIELD_ID_LABEL"
               description ="JGLOBAL_FIELD_ID_DESC" size="10" default="0"
               readonly="true" />
        <field
            name="product_id"
            type="product"
            label="COM_STANDARD_PRODUCTS"
            description="COM_STANDARD_PRODUCTS"
            readonly="true"
        />
        
        <field name="catid"
               type="categoryedit"
               label="JCATEGORY"
               description="JFIELD_CATEGORY_DESC"
               required="true"
               default=""
        >
        </field>
       
        <field name="start_date" type="calendar"
               label="COM_STANDARD_FIELD_START_DATE_LABEL" description="COM_STANDARD_FIELD_START_DATE_DESC"
               translateformat="true"
               showtime="true"
               size="22"
               filter="user_utc" 
        />

        <field name="expiry_date" type="calendar"
               label="COM_STANDARD_FIELD_EXPIRY_DATE_LABEL" description="COM_STANDARD_FIELD_EXPIRY_DATE_DESC"
               translateformat="true"
               showtime="true"
               size="22"
               filter="user_utc" 
        />
        
        <field
            name="periodDate" 
            class="period-date"
            type="daterangepicker"
            label="COM_STANDARD_PERIOD_LABEL"
            description="COM_STANDARD_PERIOD_DESC"
            hint="DATE_RANGE"
            default=""
            readonly="true"
        />
        
        <field id="cb0" name="sunday" type="checkbox" onclick="isChecked(this.checked);" label="Sunday" description="Sunday" default="0"/>
        <field id="cb1" name="monday" type="checkbox" onclick="isChecked(this.checked);" label="Monday" description="Monday" default="0"/>
        <field id="cb2" name="tuesday" type="checkbox" onclick="isChecked(this.checked);" label="Tuesday" description="Tuesday" default="0"/>
        <field id="cb3" name="wednesday" type="checkbox" onclick="isChecked(this.checked);" label="Wednesday" description="Wednesday" default="0"/>
        <field id="cb4" name="thursday" type="checkbox" onclick="isChecked(this.checked);" label="Thursday" description="Thursday" default="0"/>
        <field id="cb5" name="friday" type="checkbox" onclick="isChecked(this.checked);" label="Friday" description="Friday" default="0"/>
        <field id="cb6" name="saturday" type="checkbox" onclick="isChecked(this.checked);" label="Saturday" description="Saturday" default="0"/>

        <field name="allotment" 
               type="number" 
               label="COM_STANDARD_ALLOTMENTS_ALLOTMENT"
               description="COM_STANDARD_ALLOTMENTS_ALLOTMENT" 
               default="0" 
               min="0"
               step="1"
        />
                
        <field name="sunsat"
               type="radio"
               class="btn-group btn-group-yesno"
               default="0"
               label="Sunday or Saturday"
        >
            <option value="1">JYES</option>
            <option value="0">JNO</option>
        </field>
        <field name="allotment_sunday" 
               type="number" 
               label="Sunday allotment" 
               description="Sunday allotment"
               default="0" 
               min="0"
               step="1" 
               showon="sunsat:1"
        />
        
        <field name="allotment_saturday" 
               type="number" 
               label="Saturday allotment" 
               description="Saturday allotment"
               default="0" 
               min="0"
               step="1" 
               showon="sunsat:1"
        />
                
        <field name="state" type="list" label="JSTATUS"
               description="JFIELD_PUBLISHED_DESC" class="chzn-color-state"
               filter="intval" size="1" default="1"
        >
            <option value="1">
                JPUBLISHED</option>
            <option value="0">
                JUNPUBLISHED</option>
            <option value="2">
                JARCHIVED</option>
            <option value="-2">
                JTRASHED</option>
        </field>
        
        <field
            name="buttonspacer"
            description="JGLOBAL_ACTION_PERMISSIONS_DESCRIPTION"
            type="spacer" />

        <field name="created" type="calendar" label="COM_STANDARD_FIELD_CREATED_LABEL" description="COM_STANDARD_FIELD_CREATED_DESC"
               translateformat="true"
               weeknumbers="true"
               showtime="true"
               size="22"
               filter="user_utc" />

        <field name="created_by" type="user"
               label="COM_STANDARD_FIELD_CREATED_BY_LABEL" description="COM_STANDARD_FIELD_CREATED_BY_DESC" />

        <field name="created_by_alias" type="text"
               label="COM_STANDARD_FIELD_CREATED_BY_ALIAS_LABEL" description="COM_STANDARD_FIELD_CREATED_BY_ALIAS_DESC"
               size="20" />

        <field name="modified" type="calendar" label="JGLOBAL_FIELD_MODIFIED_LABEL" description="COM_STANDARD_FIELD_MODIFIED_DESC"
               translateformat="true"
               showtime="true"
               size="22"
               readonly="true"
               filter="user_utc" />

        <field name="modified_by" type="user"
               label="JGLOBAL_FIELD_MODIFIED_BY_LABEL"
               class="readonly"
               readonly="true"
               filter="unset"
        />

        <field name="checked_out" type="hidden" filter="unset" />

        <field name="checked_out_time" type="hidden" filter="unset" />

        <field name="publish_up" type="calendar" label="COM_STANDARD_FIELD_PUBLISH_UP_LABEL" description="COM_STANDARD_FIELD_PUBLISH_UP_DESC"
               translateformat="true"
               showtime="true"
               size="22"
               filter="user_utc" />

        <field name="publish_down" type="calendar" label="COM_STANDARD_FIELD_PUBLISH_DOWN_LABEL" description="COM_STANDARD_FIELD_PUBLISH_DOWN_DESC"
               translateformat="true"
               showtime="true"
               size="22"
               filter="user_utc" />

        <field name="version" type="text" class="readonly"
               label="COM_STANDARD_FIELD_VERSION_LABEL" size="6" description="COM_STANDARD_FIELD_VERSION_DESC"
               readonly="true" filter="unset" />

        <field name="ordering" type="text" label="JFIELD_ORDERING_LABEL"
               description="JFIELD_ORDERING_DESC" size="6"
               default="0" />

        <field name="access" type="accesslevel" label="JFIELD_ACCESS_LABEL"
               description="JFIELD_ACCESS_DESC" size="1" />

        <field name="hits" type="text" label="JGLOBAL_HITS"
               description="COM_STANDARD_FIELD_HITS_DESC" class="readonly" size="6"
               readonly="true" filter="unset" />

        <field name="language" type="contentlanguage" label="JFIELD_LANGUAGE_LABEL"
               description="COM_STANDARD_FIELD_LANGUAGE_DESC"
        >
            <option value="*">JALL</option>
        </field>

        <field name="rules" type="rules" label="JFIELD_RULES_LABEL"
               translate_label="false" filter="rules"
               component="com_standard" section="allotment" validate="rules"
        />
    </fieldset>

</form>
