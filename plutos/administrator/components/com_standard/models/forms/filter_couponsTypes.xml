<?xml version="1.0" encoding="utf-8"?>
<form>
    <fields name="filter">
        <field
            name="search"
            type="text"
            label="COM_STANDARD_FILTER_SEARCH_LABEL"
            description="COM_STANDARD_FILTER_SEARCH_DESC"
            hint="JSEARCH_FILTER"
        />
        <field
            name="published"
            type="status"
            label="COM_STANDARD_FILTER_PUBLISHED"
            description="COM_STANDARD_FILTER_PUBLISHED_DESC"
            onchange="this.form.submit();"
        >
            <option value="">JOPTION_SELECT_PUBLISHED</option>
        </field>

        <field
            name="access"
            type="accesslevel"
            label="JOPTION_FILTER_ACCESS"
            description="JOPTION_FILTER_ACCESS_DESC"
            onchange="this.form.submit();"
        >
            <option value="">JOPTION_SELECT_ACCESS</option>
        </field>
        <field
            name="author_id"
            type="AuthorCouponType"
            label="COM_STANDARD_FILTER_AUTHOR"
            description="COM_STANDARD_FILTER_AUTHOR_DESC"
            onchange="this.form.submit();"
        >
            <option value="">JOPTION_SELECT_AUTHOR</option>
        </field>
        <field
            name="language"
            type="contentlanguage"
            label="JOPTION_FILTER_LANGUAGE"
            description="JOPTION_FILTER_LANGUAGE_DESC"
            onchange="this.form.submit();"
        >
            <option value="">JOPTION_SELECT_LANGUAGE</option>
            <option value="*">JALL</option>
        </field>
    </fields>
    <fields name="list">
        <field
            name="fullordering"
            type="list"
            label="COM_STANDARD_LIST_FULL_ORDERING"
            description="COM_STANDARD_LIST_FULL_ORDERING_DESC"
            onchange="this.form.submit();"
            default="ct.id DESC"
        >
            <option value="">JGLOBAL_SORT_BY</option>
            <option value="ct.ordering ASC">JGRID_HEADING_ORDERING_ASC</option>
            <option value="ct.ordering DESC">JGRID_HEADING_ORDERING_DESC</option>
            <option value="ct.state ASC">JSTATUS_ASC</option>
            <option value="ct.state DESC">JSTATUS_DESC</option>

            <option value="ct.value_mathop DESC">COM_STANDARD_HEADING_VALUE_MATHOP_DESC</option>
            <option value="ct.value_mathop ASC">COM_STANDARD_HEADING_VALUE_MATHOP_ASC</option>
            <option value="ct.value DESC">COM_STANDARD_HEADING_VALUE_DESC</option>
            <option value="ct.value ASC">COM_STANDARD_HEADING_VALUE_ASC</option>
            <option value="currency ASC">COM_STANDARD_HEADING_CURRENCY_ASC</option>
            <option value="currency DESC">COM_STANDARD_HEADING_CURRENCY_DESC</option>
            
            <option value="ct.access ASC">JGRID_HEADING_ACCESS_ASC</option>
            <option value="ct.access DESC">JGRID_HEADING_ACCESS_DESC</option>
            <option value="ct.created_by ASC">JAUTHOR_ASC</option>
            <option value="ct.created_by DESC">JAUTHOR_DESC</option>
            <option value="language ASC">JGRID_HEADING_LANGUAGE_ASC</option>
            <option value="language DESC">JGRID_HEADING_LANGUAGE_DESC</option>
            <option value="ct.created ASC">JDATE_ASC</option>
            <option value="ct.created DESC">JDATE_DESC</option>
            <option value="ct.id ASC">JGRID_HEADING_ID_ASC</option>
            <option value="ct.id DESC">JGRID_HEADING_ID_DESC</option>
        </field>
        <field
            name="limit"
            type="limitbox"
            class="input-mini"
            default="25"
            label="COM_STANDARD_LIST_LIMIT"
            description="COM_STANDARD_LIST_LIMIT_DESC"
            onchange="this.form.submit();"
        />
    </fields>
</form>
