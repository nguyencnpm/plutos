<?xml version="1.0" encoding="utf-8"?>
<form>
    <fieldset>
        <field name="id"  type="text" class="readonly" label="JGLOBAL_FIELD_ID_LABEL"
               description ="JGLOBAL_FIELD_ID_DESC" size="10" default="0"
               readonly="true" />

        <field name="title" type="text" label="JGLOBAL_TITLE"
               description="JFIELD_TITLE_DESC"
               class="input-xxlarge input-large-text"
               size="40"
               required="true" />

        <field name="alias" type="text" label="JFIELD_ALIAS_LABEL"
               description="JFIELD_ALIAS_DESC"
               hint="JFIELD_ALIAS_PLACEHOLDER"
               size="40" />
        
        <field name="exchange_rate" 
               type="number" 
               label="COM_STANDARD_CURRENCY_EXCHANGE_RATE_LABEL"
               description="COM_STANDARD_CURRENCY_EXCHANGE_RATE_DESC" 
               default="1" 
               required="true"
               step="0.00001"
               min="0"
        />
        
        <field name="code_2" 
               type="text" 
               label="COM_STANDARD_CURRENCY_CODE_2_LETTERS_LABEL" 
               maxlength="2"
        />
        
        <field name="code_3" 
               type="text" 
               label="COM_STANDARD_CURRENCY_CODE_3_LETTERS_LABEL"
               maxlength="3"
               required="true"
        />
        
        <field name="numeric_code" 
               type="text" 
               label="COM_STANDARD_CURRENCY_NUMERIC_CODE_LABEL"
               maxlength="3"
        />
       
        <field name="symbol" 
               type="text" 
               label="COM_STANDARD_CURRENCY_SYMBOL_LABEL"
               maxlength="20"
               required="true"
        />
         
        <field name="decimal_place" 
               type="text" 
               label="COM_STANDARD_CURRENCY_DECIMALS_LABEL"
               maxlength="10"
        />
        
        <field name="decimal_symbol" 
               type="text" 
               label="COM_STANDARD_CURRENCY_DECIMAL_SYMBOL_LABEL"
               maxlength="10"
        />
        
        <field name="thousands" 
               type="text" 
               label="COM_STANDARD_CURRENCY_THOUSANDS_SEPARATOR_LABEL"
               maxlength="10"
        />
        
        <field name="positive_style" 
               class="span12"
               type="text" 
               default="{number} {symbol}" 
               label="COM_STANDARD_CURRENCY_POSITIVE_FORMAT_LABEL"
               description="COM_STANDARD_CURRENCY_POSITIVE_FORMAT_DESC" 
        />
        
        <field name="negative_style" 
               class="span12"
               type="text" 
               default="{sign}{number} {symbol}" 
               label="COM_STANDARD_CURRENCY_NEGATIVE_FORMAT_LABEL"
               description="{sign}{number} {symbol}" 
        />

        <field name="state" type="list" label="JSTATUS"
               description="JFIELD_PUBLISHED_DESC" class="chzn-color-state"
               filter="intval" size="1" default="1"
        >
            <option value="1">JPUBLISHED</option>
            <option value="0">JUNPUBLISHED</option>
            <option value="2">JARCHIVED</option>
            <option value="-2">JTRASHED</option>
        </field>

        <field
            name="buttonspacer"
            description="JGLOBAL_ACTION_PERMISSIONS_DESCRIPTION"
            type="spacer" />

        <field name="created" type="calendar" label="COM_STANDARD_FIELD_CREATED_LABEL"
               translateformat="true"
               showtime="true"
               size="22"
               filter="user_utc" 
        />

        <field name="created_by" type="user"
               label="COM_STANDARD_FIELD_CREATED_BY_LABEL" description="COM_STANDARD_FIELD_CREATED_BY_DESC" />

        <field name="created_by_alias" type="text"
               label="COM_STANDARD_FIELD_CREATED_BY_ALIAS_LABEL" description="COM_STANDARD_FIELD_CREATED_BY_ALIAS_DESC"
               size="20" />

        <field name="modified" type="calendar"
               label="JGLOBAL_FIELD_MODIFIED_LABEL" description="COM_STANDARD_FIELD_MODIFIED_DESC"
               class="readonly"
               translateformat="true"
               showtime="true"
               size="22"
               readonly="true"
               filter="user_utc" 
        />

        <field name="modified_by" type="user"
               label="JGLOBAL_FIELD_MODIFIED_BY_LABEL"
               class="readonly"
               readonly="true"
               filter="unset"
        />

        <field name="checked_out" type="hidden" filter="unset" />

        <field name="checked_out_time" type="hidden" filter="unset" />

        <field name="ordering" type="text" label="JFIELD_ORDERING_LABEL"
               description="JFIELD_ORDERING_DESC" size="6"
               default="0" />

        <field name="access" type="accesslevel" label="JFIELD_ACCESS_LABEL"
               description="JFIELD_ACCESS_DESC" size="1" />

        <field name="language" type="contentlanguage" label="JFIELD_LANGUAGE_LABEL"
               description="COM_STANDARD_FIELD_LANGUAGE_DESC"
        >
            <option value="*">JALL</option>
        </field>

        <field name="rules" type="rules" label="JFIELD_RULES_LABEL"
               translate_label="false" filter="rules"
               component="com_standard" section="currency" validate="rules"
        />

    </fieldset>
</form>
