<?xml version="1.0" encoding="utf-8"?>
<form>
    <fieldset>
        <field name="id"  type="text" class="readonly" label="JGLOBAL_FIELD_ID_LABEL"
               description ="JGLOBAL_FIELD_ID_DESC" size="10" default="0"
               readonly="true" />
        
        <field name="title" type="text" label="COM_STANDARD_AGENT_LABEL"
               description="JFIELD_TITLE_DESC"
               class="input-xxlarge input-large-text"
               size="40"
               required="true" />

        <field name="alias" type="text" label="JFIELD_ALIAS_LABEL"
               description="JFIELD_ALIAS_DESC"
               hint="JFIELD_ALIAS_PLACEHOLDER"
               size="40" />
        <!--
        <field name="user_id" type="user" 
               label="COM_STANDARD_USER_HEADING_NAME"
               description="COM_STANDARD_USER_FIELD_NAME_DESC" 
               required="true" />
        -->
        <field name="credit"
               type="radio"
               class="btn-group btn-group-yesno span12"
               default="0"
               label="Credit"
        >
            <option value="1">JYES</option>
            <option value="0">JNO</option>
        </field>
        <!--  limitproducts -->
        <field name="limit_products" 
               type="number" 
               label="COM_STANDARD_LIMIT_PRODUCTS_LABEL"
               description="COM_STANDARD_LIMIT_PRODUCTS_DESC" 
               min="0"
               useglobal="true"
        /> 
        
        <field name="telephone" 
               type="text" 
               class="span12"
               label="COM_STANDARD_TELEPHONE"
               description="COM_STANDARD_TELEPHONE" />
        <field name="mobile" 
               type="text" 
               class="span12"
               label="COM_STANDARD_MOBILE" 
               description="COM_STANDARD_MOBILE" />
        <field name="fax" 
               type="text" 
               class="span12"
               label="COM_STANDARD_FAX"
               description="COM_STANDARD_FAX" />
        <field
            name="email"
            type="email"
            class="span12"
            label="JGLOBAL_EMAIL"
            description="COM_CONTACT_FIELD_INFORMATION_EMAIL_DESC"
        />
        <field
            name="address"
            type="textarea"
            class="span12"
            label="COM_STANDARD_ADDRESS_LABEL"
            description="COM_STANDARD_ADDRESS_DESC"
            rows="1"
        />
        <field 
            name="country_id" 
            type="Country" 
            class="span12"
            label="COM_STANDARD_COUNTRY"
            description="COM_STANDARD_COUNTRY" 
            default="0" 
        >
            <option value="0">COM_STANDARD_COUNTRY_SELECT</option>
        </field>
        
        <field 
            name="state_id" 
            type="States" 
            class="span12"
            label="COM_STANDARD_STATE_LABEL"
            description="COM_STANDARD_STATE_DESC" 
            default="0" 
        >
            <option value="0">COM_STANDARD_SELECT_STATE</option>
        </field>
        
        <field name="catid" 
               type="CategoryEdit" 
               label="COM_STANDARD_CATEGORIES"
               description="COM_STANDARD_CATEGORY_DESC" 
               class="span12"
               multiple="true"/>
        
        <field name="agenttext" type="editor"
               label="COM_STANDARD_FIELD_AGENTTEXT_LABEL" description="COM_STANDARD_FIELD_AGENTTEXT_DESC"
               filter="JComponentHelper::filterText" buttons="true" />
        
        
        
        <field name="state" type="list" label="JSTATUS"
               description="JFIELD_PUBLISHED_DESC" class="chzn-color-state"
               filter="intval" size="1" default="1"
        >
            <option value="1">
                JPUBLISHED</option>
            <option value="0">
                JUNPUBLISHED</option>
            <option value="2">
                JARCHIVED</option>
            <option value="-2">
                JTRASHED</option>
        </field>

        <field
            name="buttonspacer"
            description="JGLOBAL_ACTION_PERMISSIONS_DESCRIPTION"
            type="spacer" />

        <field name="created" type="calendar" label="COM_STANDARD_FIELD_CREATED_LABEL" description="COM_STANDARD_FIELD_CREATED_DESC"
               translateformat="true"
               weeknumbers="true"
               showtime="true"
               size="22"
               filter="user_utc" />

        <field name="created_by" type="user"
               label="COM_STANDARD_FIELD_CREATED_BY_LABEL" description="COM_STANDARD_FIELD_CREATED_BY_DESC" />

        <field name="created_by_alias" type="text"
               label="COM_STANDARD_FIELD_CREATED_BY_ALIAS_LABEL" description="COM_STANDARD_FIELD_CREATED_BY_ALIAS_DESC"
               size="20" />

        <field name="modified" type="calendar" class="readonly" label="JGLOBAL_FIELD_MODIFIED_LABEL" description="COM_STANDARD_FIELD_MODIFIED_DESC"
               translateformat="true"
               showtime="true"
               size="22"
               readonly="true"
               filter="user_utc" />

        <field name="modified_by" type="user"
               label="JGLOBAL_FIELD_MODIFIED_BY_LABEL"
               class="readonly"
               readonly="true"
               filter="unset"
        />

        <field name="checked_out" type="hidden" filter="unset" />

        <field name="checked_out_time" type="hidden" filter="unset" />
        
        <field name="publish_up" type="calendar" label="COM_STANDARD_FIELD_PUBLISH_UP_LABEL" description="COM_STANDARD_FIELD_PUBLISH_UP_DESC"
               translateformat="true"
               showtime="true"
               size="22"
               filter="user_utc" />

        <field name="publish_down" type="calendar" label="COM_STANDARD_FIELD_PUBLISH_DOWN_LABEL" description="COM_STANDARD_FIELD_PUBLISH_DOWN_DESC"
               translateformat="true"
               showtime="true"
               size="22"
               filter="user_utc" />

        <field name="version" type="text" class="readonly"
               label="COM_STANDARD_FIELD_VERSION_LABEL" size="6" description="COM_STANDARD_FIELD_VERSION_DESC"
               readonly="true" filter="unset" />

        <field name="ordering" type="text" label="JFIELD_ORDERING_LABEL"
               description="JFIELD_ORDERING_DESC" size="6"
               default="0" />

        <field name="access" type="accesslevel" label="JFIELD_ACCESS_LABEL"
               description="JFIELD_ACCESS_DESC" size="1" />

        <field name="language" type="contentlanguage" label="JFIELD_LANGUAGE_LABEL"
               description="COM_STANDARD_FIELD_LANGUAGE_DESC"
        >
            <option value="*">JALL</option>
        </field>

    </fieldset>
    
    <fields name="images" label="COM_STANDARD_FIELD_IMAGE_OPTIONS">
        <field
            name="image_avatar"
            type="media"
            label="COM_STANDARD_FIELD_INTRO_AVATAR_LABEL"
            description="COM_STANDARD_FIELD_INTRO_AVATAR_DESC" />
        <field
            name="float_avatar"
            type="list"
            label="COM_STANDARD_FLOAT_LABEL"
            description="COM_STANDARD_FLOAT_DESC">
            <option value="">JGLOBAL_USE_GLOBAL</option>
            <option value="right">COM_STANDARD_RIGHT</option>
            <option value="left">COM_STANDARD_LEFT</option>
            <option value="none">COM_STANDARD_NONE</option>
        </field>
        <field name="image_avatar_alt"
               type="text"
               label="COM_STANDARD_FIELD_IMAGE_ALT_LABEL"
               description="COM_STANDARD_FIELD_IMAGE_ALT_DESC"
               size="20"/>
        <field name="image_avatar_caption"
               type="text"
               label="COM_STANDARD_FIELD_IMAGE_CAPTION_LABEL"
               description="COM_STANDARD_FIELD_IMAGE_CAPTION_DESC"
               size="20"/>
    </fields>
    <!-- These fields are used to get labels for the Content History Preview and Compare Views -->
    <fields>
        <field name="introtext" label="COM_STANDARD_FIELD_INTROTEXT" />
        <field name="fulltext" label="COM_STANDARD_FIELD_FULLTEXT" />
    </fields>
</form>
