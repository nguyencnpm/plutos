<?xml version="1.0" encoding="utf-8"?>
<form>
    <fieldset>
        <field name="id"  type="text" class="readonly" label="JGLOBAL_FIELD_ID_LABEL"
               description ="JGLOBAL_FIELD_ID_DESC" default="0"
               readonly="true" 
        />
        <field name="number"  type="text" class="readonly" label="COM_STANDARD_ORDER_NUMBER_LABEL"
               description ="COM_STANDARD_ORDER_NUMBER_DESC" default="0"
               readonly="true" 
        />
        
        <field name="totalQuantity" 
               type="number" 
               class="readonly"
               label="COM_STANDARD_TOTAL_QUANTITY_LABEL"
               description="COM_STANDARD_TOTAL_QUANTITY_DESC" 
               default="0" 
               readonly="true"
               min="0"
        />
        <field name="order_item_currency" 
               type="listcurrencies" 
               class="readonly"
               label="COM_STANDARD_CURRENCY"
               description="COM_STANDARD_CURRENCY" 
               default="147" 
               readonly="true"
        />
        
        <field name="salesPrice" 
               type="number" 
               class="readonly"
               label="COM_STANDARD_SALES_PRICE_LABEL"
               description="COM_STANDARD_SALES_PRICE_DESC" 
               default="0" 
               readonly="true"
               step="0.00001"
               min="0"
        />
        
        <field name="billTaxAmount" 
               type="number" 
               class="readonly"
               label="COM_STANDARD_BILL_TAX_AMOUNT_LABEL"
               description="COM_STANDARD_BILL_TAX_AMOUNT_DESC" 
               default="0" 
               readonly="true"
               step="0.00001"
               min="0"
        />
        
        <field name="billDiscountAmount" 
               type="number" 
               class="readonly"
               label="COM_STANDARD_BILL_DISCOUNT_AMOUNT_LABEL"
               description="COM_STANDARD_BILL_DISCOUNT_AMOUNT_DESC" 
               default="0" 
               readonly="true"
               step="0.00001"
               min="0"
        />
        <field name="discountAmount" 
               type="number" 
               class="readonly"
               label="COM_STANDARD_DISCOUNT_AMOUNT_LABEL"
               description="COM_STANDARD_DISCOUNT_AMOUNT_DESC" 
               default="0" 
               readonly="true"
               step="0.00001"
               min="0"
        />
        
        <field name="total" 
               type="number" 
               class="readonly"
               label="COM_STANDARD_TOTAL_LABEL"
               description="COM_STANDARD_TOTAL_DESC" 
               default="0" 
               readonly="true"
               step="0.00001"
               min="0"
        />
        
        <field name="ip_address"  type="text" class="readonly" 
               label="COM_STANDARD_IP_ADDRESS_LABEL"
               description ="COM_STANDARD_IP_ADDRESS_DESC"  
               default="xx"
               readonly="true" 
        />
        <field name="device"  type="text" class="readonly" 
               label="COM_STANDARD_DEVICES_LABEL"
               description ="COM_STANDARD_DEVICES_DESC"  
               default="-"
               readonly="true" 
        />
        
        
        <field name="state" type="list" label="JSTATUS"
               description="JFIELD_PUBLISHED_DESC" class="chzn-color-state"
               filter="intval" size="1" default="1"
        >
            <option value="1">COM_STANDARD_TOGGLE_PUBLISHED</option>
            <option value="0">COM_STANDARD_TOGGLE_UNPUBLISHED</option>
            <option value="2">COM_STANDARD_TOGGLE_ARCHIVE</option>
            <option value="-2">COM_STANDARD_TOGGLE_TRASH</option>
        </field>

        <field
            name="buttonspacer"
            description="JGLOBAL_ACTION_PERMISSIONS_DESCRIPTION"
            type="spacer" />

        <field name="created" type="calendar" label="COM_STANDARD_FIELD_ORDER_DATE_LABEL"
               class="readonly"
               translateformat="true"
               showtime="true"
               readonly="true"
               filter="user_utc" 
        />

        <field name="created_by" type="user"
               label="COM_STANDARD_FIELD_CREATED_BY_LABEL" description="COM_STANDARD_FIELD_CREATED_BY_DESC" />

        <field name="created_by_alias" type="text"
               label="COM_STANDARD_FIELD_CREATED_BY_ALIAS_LABEL" description="COM_STANDARD_FIELD_CREATED_BY_ALIAS_DESC"
               size="20" />

        <field name="modified" type="calendar"
               label="JGLOBAL_FIELD_MODIFIED_LABEL" description="COM_STANDARD_FIELD_MODIFIED_DESC"
               class="readonly"
               translateformat="true"
               showtime="true"
               size="22"
               readonly="true"
               filter="user_utc" 
        />

        <field name="modified_by" type="user"
               label="JGLOBAL_FIELD_MODIFIED_BY_LABEL"
               class="readonly"
               readonly="true"
               filter="unset"
        />

        <field name="checked_out" type="hidden" filter="unset" />

        <field name="checked_out_time" type="hidden" filter="unset" />

        <field name="ordering" type="text" label="JFIELD_ORDERING_LABEL"
               description="JFIELD_ORDERING_DESC" size="6"
               default="0" />

        <field name="access" type="accesslevel" label="JFIELD_ACCESS_LABEL"
               description="JFIELD_ACCESS_DESC" size="1" />

        <field name="language" type="contentlanguage" label="JFIELD_LANGUAGE_LABEL"
               description="COM_STANDARD_FIELD_LANGUAGE_DESC"
        >
            <option value="*">JALL</option>
        </field>

        <field name="rules" type="rules" label="JFIELD_RULES_LABEL"
               translate_label="false" filter="rules"
               component="com_standard" section="order" validate="rules"
        />
    </fieldset>
</form>
