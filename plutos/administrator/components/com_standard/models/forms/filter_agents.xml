<?xml version="1.0" encoding="utf-8"?>
<form>
    <fields name="filter">
        <field
            name="search"
            type="text"
            label="COM_STANDARD_FILTER_SEARCH_LABEL"
            description="COM_STANDARD_FILTER_SEARCH_DESC"
            hint="JSEARCH_FILTER"
        />
        <field
            name="published"
            type="status"
            label="COM_STANDARD_FILTER_PUBLISHED"
            description="COM_STANDARD_FILTER_PUBLISHED_DESC"
            onchange="this.form.submit();"
        >
            <option value="">JOPTION_SELECT_PUBLISHED</option>
        </field>

        <field
            name="access"
            type="accesslevel"
            label="JOPTION_FILTER_ACCESS"
            description="JOPTION_FILTER_ACCESS_DESC"
            onchange="this.form.submit();"
        >
            <option value="">JOPTION_SELECT_ACCESS</option>
        </field>
        <field
            name="author_id"
            type="author"
            label="COM_STANDARD_FILTER_AUTHOR"
            description="COM_STANDARD_FILTER_AUTHOR_DESC"
            onchange="this.form.submit();"
        >
            <option value="">JOPTION_SELECT_AUTHOR</option>
        </field>
        <field
            name="language"
            type="contentlanguage"
            label="JOPTION_FILTER_LANGUAGE"
            description="JOPTION_FILTER_LANGUAGE_DESC"
            onchange="this.form.submit();"
        >
            <option value="">JOPTION_SELECT_LANGUAGE</option>
            <option value="*">JALL</option>
        </field>
    </fields>
    <fields name="list">
        <field
            name="fullordering"
            type="list"
            label="COM_STANDARD_LIST_FULL_ORDERING"
            description="COM_STANDARD_LIST_FULL_ORDERING_DESC"
            onchange="this.form.submit();"
            default="ta.id DESC"
        >
            <option value="">JGLOBAL_SORT_BY</option>
            <option value="ta.ordering ASC">JGRID_HEADING_ORDERING_ASC</option>
            <option value="ta.ordering DESC">JGRID_HEADING_ORDERING_DESC</option>
            <option value="ta.published ASC">JSTATUS_ASC</option>
            <option value="ta.published DESC">JSTATUS_DESC</option>
            <option value="ta.title ASC">JGLOBAL_TITLE_ASC</option>
            <option value="ta.title DESC">JGLOBAL_TITLE_DESC</option>
            <option value="ta.code ASC">COM_STANDARD_CODE_ASC</option>
            <option value="ta.code DESC">COM_STANDARD_CODE_DESC</option>
            <option value="ta.telephone ASC">COM_STANDARD_TELEPHONE_ASC</option>
            <option value="ta.telephone DESC">COM_STANDARD_TELEPHONE_DESC</option>
            <option value="ta.email ASC">COM_STANDARD_EMAIL_ASC</option>
            <option value="ta.email DESC">COM_STANDARD_EMAIL_DESC</option>
            
            <option value="ta.access ASC">JGRID_HEADING_ACCESS_ASC</option>
            <option value="ta.access DESC">JGRID_HEADING_ACCESS_DESC</option>
            <option value="ta.created_by ASC">JAUTHOR_ASC</option>
            <option value="ta.created_by DESC">JAUTHOR_DESC</option>
            <option value="language ASC">JGRID_HEADING_LANGUAGE_ASC</option>
            <option value="language DESC">JGRID_HEADING_LANGUAGE_DESC</option>
            <option value="ta.created ASC">JDATE_ASC</option>
            <option value="ta.created DESC">JDATE_DESC</option>
            <option value="ta.id ASC">JGRID_HEADING_ID_ASC</option>
            <option value="ta.id DESC">JGRID_HEADING_ID_DESC</option>
        </field>
        <field
            name="limit"
            type="limitbox"
            class="input-mini"
            default="25"
            label="COM_STANDARD_LIST_LIMIT"
            description="COM_STANDARD_LIST_LIMIT_DESC"
            onchange="this.form.submit();"
        />
    </fields>
</form>
