<?xml version="1.0" encoding="utf-8"?>
<form>

    <field
        name="id"
        type="number"
        label="JGLOBAL_FIELD_ID_LABEL"
        description="JGLOBAL_FIELD_ID_DESC"
        default="0"
        class="readonly"
        readonly="true"
    />

    <field
        name="hits"
        type="number"
        label="JGLOBAL_HITS"
        description="COM_STANDARD_CATEGORIES_FIELD_HITS_DESC"
        default="0"
        class="readonly"
        readonly="true"
    />

    <field
        name="asset_id"
        type="hidden"
        filter="unset"
        label="JFIELD_ASSET_ID_LABEL"
        description="JFIELD_ASSET_ID_DESC"
    />

    <field
        name="parent_id"
        type="categoryedit"
        label="COM_STANDARD_CATEGORIES_FIELD_PARENT_LABEL"
        description="COM_STANDARD_CATEGORIES_FIELD_PARENT_DESC"
    />

    <field
        name="lft"
        type="hidden"
        filter="unset"
    />

    <field
        name="rgt"
        type="hidden"
        filter="unset"
    />

    <field
        name="level"
        type="hidden"
        filter="unset"
    />

    <field
        name="path"
        type="text"
        label="COM_STANDARD_CATEGORIES_PATH_LABEL"
        description="COM_STANDARD_CATEGORIES_PATH_DESC"
        class="readonly"
        size="40"
        readonly="true"
    />

    <field
        name="extension"
        type="hidden"
    />

    <field
        name="title"
        type="text"
        label="JGLOBAL_TITLE"
        description="JFIELD_TITLE_DESC"
        class="input-xxlarge input-large-text"
        size="40"
        required="true"
    />

    <field
        name="alias"
        type="text"
        label="JFIELD_ALIAS_LABEL"
        description="JFIELD_ALIAS_DESC"
        size="45"
        hint="JFIELD_ALIAS_PLACEHOLDER"
    />

    <field
        name="version_note"
        type="text"
        label="JGLOBAL_FIELD_VERSION_NOTE_LABEL"
        description="JGLOBAL_FIELD_VERSION_NOTE_DESC"
        class="span12"
        size="45"
        maxlength="255"
    />

    <field
        name="note"
        type="text"
        label="COM_STANDARD_CATEGORIES_FIELD_NOTE_LABEL"
        description="COM_STANDARD_CATEGORIES_FIELD_NOTE_DESC"
        class="span12"
        size="40"
        maxlength="255"
    />

    <field
        name="description"
        type="editor"
        label="JGLOBAL_DESCRIPTION"
        description="COM_STANDARD_CATEGORIES_DESCRIPTION_DESC"
        filter="JComponentHelper::filterText"
        buttons="true"
        hide="readmore,pagebreak"
    />
    
    <field
        name="file_terms_conditions"
        type="media"
        mediatype=""
        label="COM_STANDARD_FILE_TERMS_CONDITIONS_LABEL"
        description="COM_STANDARD_FILE_TERMS_CONDITIONS_DESC" 
    />

    <fields name="attachments" label="COM_STANDARD_FIELD_ATTACHMENT_OPTIONS">
        <field
            name="file1"
            type="media"
            mediatype=""
            label="COM_STANDARD_FIELD_FILE_1_LABEL"
            description="COM_STANDARD_FILE_1_DESC" 
            class="span12"
        />
    </fields>
    
    <field name="code" 
           type="text" 
           label="COM_STANDARD_CODE"
           description="COM_STANDARD_CODE" 
           class="span12"
    />
    <field name="isService" 
           type="list" 
           label="COM_STANDARD_IS_SERVICE"
           description="COM_STANDARD_IS_SERVICE_DESC" 
           class="chzn-color-state span12"
           filter="intval" 
           default="2"
    >
        <option value="">COM_STANDARD_SELECT_A_SERVICE</option>
        <option value="1">SERVICE_OPERA</option>
        <option value="2">SERVICE_SMILE</option>
    </field>
        
    <field name="profileCode" 
           type="text" 
           label="COM_STANDARD_PROFILE_CODE"
           description="COM_STANDARD_PROFILE_CODE_DESC" 
           class="span12"
    />
        
    <field
        name="published"
        type="list"
        label="JSTATUS"
        description="JFIELD_PUBLISHED_DESC"
        default="1"
        class="chzn-color-state"
        size="1"
    >
        <option value="1">JPUBLISHED</option>
        <option value="0">JUNPUBLISHED</option>
        <option value="2">JARCHIVED</option>
        <option value="-2">JTRASHED</option>
    </field>

    <field
        name="buttonspacer"
        type="spacer"
        label="JGLOBAL_ACTION_PERMISSIONS_LABEL"
        description="JGLOBAL_ACTION_PERMISSIONS_DESCRIPTION"
    />

    <field
        name="checked_out"
        type="hidden"
        filter="unset"
    />

    <field
        name="checked_out_time"
        type="hidden"
        filter="unset"
    />

    <field
        name="access"
        type="accesslevel"
        label="JFIELD_ACCESS_LABEL"
        description="JFIELD_ACCESS_DESC"
    />

    <field
        name="metadesc"
        type="textarea"
        label="JFIELD_META_DESCRIPTION_LABEL"
        description="JFIELD_META_DESCRIPTION_DESC"
        rows="3"
        cols="40"
    />

    <field
        name="metakey"
        type="textarea"
        label="JFIELD_META_KEYWORDS_LABEL"
        description="JFIELD_META_KEYWORDS_DESC"
        rows="3"
        cols="40"
    />

    <field
        name="created_user_id"
        type="user"
        label="JGLOBAL_FIELD_CREATED_BY_LABEL"
        desc="JGLOBAL_FIELD_CREATED_BY_DESC"
    />

    <field
        name="created_time"
        type="text"
        label="JGLOBAL_CREATED_DATE"
        class="readonly"
        filter="unset"
        readonly="true"
    />

    <field
        name="modified_user_id"
        type="user"
        label="JGLOBAL_FIELD_MODIFIED_BY_LABEL"
        class="readonly"
        readonly="true"
        filter="unset"
    />

    <field
        name="modified_time"
        type="text"
        label="JGLOBAL_FIELD_MODIFIED_LABEL"
        class="readonly"
        filter="unset"
        readonly="true"
    />

    <field
        name="language"
        type="contentlanguage"
        label="JFIELD_LANGUAGE_LABEL"
        description="COM_STANDARD_CATEGORIES_FIELD_LANGUAGE_DESC"
    >
        <option value="*">JALL</option>
    </field>

    <field
        name="tags"
        type="tag"
        label="JTAG"
        description="JTAG_DESC"
        class="span12"
        multiple="true"
    />

    <field
        name="rules"
        type="rules"
        label="JFIELD_RULES_LABEL"
        id="rules"
        translate_label="false"
        filter="rules"
        validate="rules"
        component="com_standard"
        section="category"
    />
    
    <fields name="images" label="COM_STANDARD_FIELD_IMAGE_OPTIONS">
        <field name="linktype" 
               type="list" 
               label="COM_STANDARD_LINK_TYPE"
               description="COM_STANDARD_LINK_TYPE_DESC" 
               default=""
        >
            <option value="">COM_STANDARD_DO_NOT_LINK</option>
            <option value="current">COM_STANDARD_CURRENT_LINK</option>
            <option value="menu">COM_STANDARD_MENU</option>
            <option value="url">COM_STANDARD_URL</option>
            <option value="article">COM_STANDARD_ARTICLE</option>
        </field>
        
        <field name="linkmenu" 
               type="menuitem"
               label="COM_STANDARD_MENU"
               description="COM_STANDARD_MENU"
               disable="separator,heading,alias"
               showon="linktype:menu"
        />
        <field name="linkurl"
               type="text"
               label="COM_STANDARD_URL"
               description="COM_STANDARD_URL"
               class="inputbox"
               size="30"
               showon="linktype:url"
        />
        <field name="linkarticle" 
               type="modal_article"
               label="COM_STANDARD_ARTICLE" 
               description="COM_STANDARD_ARTICLE"
               select="true"
               new="true"
               edit="true"
               clear="true"
               showon="linktype:article"
        />
	
                
        <field
            name="url_type"
            type="radio"
            class="btn-group btn-group-yesno"
            default="1"
            label="COM_STANDARD_SHOW_URL_LABEL"
            description="COM_STANDARD_SHOW_URL_DESC"
            showon="linktype:current,menu,url,article"
        >
            <option value="1">COM_STANDARD_FIELD_URL_ARTICLE_LABEL</option>
            <option value="2">COM_STANDARD_FIELD_URL_IMAGE_LABEL</option>
        </field>
        
        <field name="urltext"
               type="text"
               label="COM_STANDARD_FIELD_URL_LINK_TEXT_LABEL"
               description="COM_STANDARD_FIELD_URL_LINK_TEXT_DESC"
               showon="linktype:current,menu,url,article"
        />
        		
        <field name="linktarget" 
               type="list" 
               label="COM_STANDARD_LINK_TARGET"
               description="COM_STANDARD_LINK_TARGET_DESC" 
               default=""
               showon="linktype:current,menu,url,article"
        >
            <option value="">COM_STANDARD_AUTO</option>
            <option value="_self">COM_STANDARD_PARENT_WINDOW</option>
            <option value="_blank">COM_STANDARD_NEW_WINDOW</option>
        </field>
        <field name="linktypehr" type="spacer" hr="true" />
        
        <field name="effect" type="list" 
               label="COM_STANDARD_EFFECT_LABEL" 
               description="COM_STANDARD_EFFECT_DESC">
            <option value="">COM_STANDARD_EFFECT_GLOBAL</option>
            <option value="1">COM_STANDARD_EFFECT_SCROLLING</option>
            <option value="2">COM_STANDARD_EFFECT_BACKGROUND</option>
        </field>
        <field name="scrollinghr" type="spacer" hr="true" />
        
        <field name="COM_STANDARD_FIELD_INTRO_LABEL" type="spacer" description="COM_STANDARD_FIELD_INTRO_DESC" />
        <field name="float_intro" type="list" label="COM_STANDARD_FLOAT_LABEL" description="COM_STANDARD_FLOAT_DESC">
            <option value="">JGLOBAL_USE_GLOBAL</option>
            <option value="right">COM_STANDARD_RIGHT</option>
            <option value="left">COM_STANDARD_LEFT</option>
            <option value="none">COM_STANDARD_NONE</option>
        </field>
        <field name="image_intro_title" type="text" label="COM_STANDARD_FIELD_IMAGE_TITLE_LABEL" description="COM_STANDARD_FIELD_IMAGE_TITLE_DESC"/>
        <field name="image_intro_alt" type="text" label="COM_STANDARD_FIELD_IMAGE_ALT_LABEL" description="COM_STANDARD_FIELD_IMAGE_ALT_DESC" size="20"/>
        <field name="image_intro_caption" type="text" label="COM_STANDARD_FIELD_IMAGE_CAPTION_LABEL" description="COM_STANDARD_FIELD_IMAGE_CAPTION_DESC" size="20"/>
        <field name="spacer2" type="spacer" hr="true" />
        <field name="COM_STANDARD_FIELD_FULL_LABEL" type="spacer" description="COM_STANDARD_FIELD_FULL_DESC" />
        <field name="float_fulltext" type="list" label="COM_STANDARD_FLOAT_LABEL" description="COM_STANDARD_FLOAT_DESC">
            <option value="">JGLOBAL_USE_GLOBAL</option>
            <option value="right">COM_STANDARD_RIGHT</option>
            <option value="left">COM_STANDARD_LEFT</option>
            <option value="none">COM_STANDARD_NONE</option>
        </field>
        <field name="image_fulltext_title" type="text" label="COM_STANDARD_FIELD_IMAGE_TITLE_LABEL" description="COM_STANDARD_FIELD_IMAGE_TITLE_DESC"/>
        <field name="image_fulltext_alt"
               type="text"
               label="COM_STANDARD_FIELD_IMAGE_ALT_LABEL"
               description="COM_STANDARD_FIELD_IMAGE_ALT_DESC"
               size="20"/>
        <field name="image_fulltext_caption"
               type="text"
               label="COM_STANDARD_FIELD_IMAGE_CAPTION_LABEL"
               description="COM_STANDARD_FIELD_IMAGE_CAPTION_DESC"
               size="20"/>
    </fields>
    
    <field
        name="banner_status"
        type="radio"
        class="btn-group btn-group-yesno"
        default="1"
        label="COM_STANDARD_SHOW_BANNER_LABEL"
        description="COM_STANDARD_SHOW_BANNER_DESC">
        <option value="1">JSHOW</option>
        <option value="0">JHIDE</option>
    </field>
    <field
        name="banner_home"
        type="radio"
        class="btn-group btn-group-yesno"
        default="0"
        label="COM_STANDARD_SHOW_BANNER_HOME_LABEL"
        description="COM_STANDARD_SHOW_BANNER_HOME_DESC">
        <option value="1">JSHOW</option>
        <option value="0">JHIDE</option>
    </field>
    
    <fields name="banners" label="COM_STANDARD_FIELD_BANNERS_OPTIONS">
        <field 
            name="effect" 
            type="EffectBackground" 
            label="COM_STANDARD_EFFECT_LABEL" 
            description="COM_STANDARD_EFFECT_DESC">
            <option value="">COM_STANDARD_EFFECT_GLOBAL</option>
        </field>
        
        <field 
            name="text_aspectratio" 
            type="TextAspectRatio" 
            label="COM_STANDARD_TEXT_ASPECT_RATIO_LABEL" 
            description="COM_STANDARD_TEXT_ASPECT_RATIO_DESC"
            default="2"
        >
            <option value="">COM_STANDARD_TEXT_GLOBAL</option>
        </field>
        
        <field 
            name="device" 
            type="Device" 
            label="COM_STANDARD_TEXT_DEVICE_LABEL" 
            description="COM_STANDARD_TEXT_DEVICE_DESC"
            default="-lg"
        >
            <option value="">DEVICE_GLOBAL</option>
        </field>
        
        <field 
            name="text_position" 
            type="Position" 
            label="COM_STANDARD_TEXT_POSITION_LABEL" 
            description="COM_STANDARD_TEXT_POSITION_DESC"
            default=""
        >
            <option value="">COM_STANDARD_TEXT_POSITION_GLOBAL</option>
        </field>
        
        <field 
            name="text_medialayoutelement"
            type="LayoutElement"
            class="span6"
            label="GLOBAL_TEXT_LAYOUT_ELEMENT_LABEL"
            description="GLOBAL_TEXT_LAYOUT_ELEMENT_DESC"
            default="using-max-width-md"
        >
            <option value=" ">JGLOBAL_USE_GLOBAL</option>
        </field>
                
        <field name="linktype" 
               type="list" 
               label="COM_STANDARD_LINK_TYPE"
               description="COM_STANDARD_LINK_TYPE_DESC" 
               default="current"
        >
            <option value="">COM_STANDARD_DO_NOT_LINK</option>
            <option value="bannercurrent">COM_STANDARD_CURRENT_LINK</option>
            <option value="bannermenu">COM_STANDARD_MENU</option>
            <option value="bannerurl">COM_STANDARD_URL</option>
            <option value="bannerarticle">COM_STANDARD_ARTICLE</option>
        </field>
        
        <field name="linkmenu" 
               type="menuitem"
               label="COM_STANDARD_MENU"
               description="COM_STANDARD_MENU"
               disable="separator,heading,alias"
               showon="linktype:bannermenu"
        />
        <field name="linkurl"
               type="text"
               label="COM_STANDARD_URL"
               description="COM_STANDARD_URL"
               class="inputbox"
               size="30"
               showon="linktype:bannerurl"
        />
        <field name="linkarticle" 
               type="modal_article"
               label="COM_STANDARD_ARTICLE" 
               description="COM_STANDARD_ARTICLE"
               select="true"
               new="true"
               edit="true"
               clear="true"
               showon="linktype:bannerarticle"
        />
	
                
        <field
            name="url_type"
            type="radio"
            class="btn-group btn-group-yesno"
            default="1"
            label="COM_STANDARD_SHOW_URL_LABEL"
            description="COM_STANDARD_SHOW_URL_DESC"
            showon="linktype:bannercurrent,bannermenu,bannerurl,bannerarticle"
        >
            <option value="1">COM_STANDARD_FIELD_URL_ARTICLE_LABEL</option>
            <option value="2">COM_STANDARD_FIELD_URL_BANNER_LABEL</option>
        </field>
        
        <field name="urlbannertext"
               type="text"
               label="COM_STANDARD_FIELD_URL_BANNER_LINK_TEXT_LABEL"
               description="COM_STANDARD_FIELD_URL_LINK_TEXT_DESC"
               showon="linktype:bannercurrent,bannermenu,bannerurl,bannerarticle"
        />
        		
        <field name="linktarget" 
               type="list" 
               label="COM_STANDARD_LINK_TARGET"
               description="COM_STANDARD_LINK_TARGET_DESC" 
               default=""
               showon="linktype:bannercurrent,bannermenu,bannerurl,bannerarticle"
        >
            <option value="">COM_STANDARD_AUTO</option>
            <option value="_self">COM_STANDARD_PARENT_WINDOW</option>
            <option value="_blank">COM_STANDARD_NEW_WINDOW</option>
        </field>
        
        <field
            name="bannertitle_status"
            type="radio"
            class="btn-group btn-group-yesno"
            default="1"
            label="COM_STANDARD_SHOW_BANNER_TITLE_STATUS_LABEL"
            description="COM_STANDARD_SHOW_BANNER_TITLE_STATUS_DESC">
            <option value="1">JSHOW</option>
            <option value="0">JHIDE</option>
        </field>
        
        <field
            name="bannertitle"
            type="textarea"
            label="COM_STANDARD_BANNERTITLE_LABEL"
            description="COM_STANDARD_BANNERTITLE_DESC"
            rows="2"
        />
        <field
            name="bannerdesc"
            type="textarea"
            label="COM_STANDARD_DESCRIPTION_LABEL"
            description="COM_STANDARD_DESCRIPTION_DESC"
            rows="2"
        />
        <field name="banner_alt" type="text" label="COM_STANDARD_FIELD_BANNER_ALT_LABEL" description="COM_STANDARD_FIELD_BANNER_ALT_DESC"/>
        <field name="banner_caption" type="text" label="COM_STANDARD_FIELD_BANNER_CAPTION_LABEL" description="COM_STANDARD_FIELD_BANNER_CAPTION_DESC"/>
    </fields>
    
    <fields name="maps" label="COM_STANDARD_FIELD_IMAGE_OPTIONS">      
        <field name="effect" type="list" 
               label="COM_STANDARD_EFFECT_LABEL" 
               description="COM_STANDARD_EFFECT_DESC">
            <option value="">COM_STANDARD_EFFECT_GLOBAL</option>
            <option value="1">COM_STANDARD_EFFECT_SCROLLING</option>
            <option value="2">COM_STANDARD_EFFECT_BACKGROUND</option>
        </field>
        <field name="scrollinghr" type="spacer" hr="true" />
        
        <field name="COM_STANDARD_FIELD_INTRO_LABEL" type="spacer" description="COM_STANDARD_FIELD_INTRO_DESC" />
        <field name="float_intro" type="list" label="COM_STANDARD_FLOAT_LABEL" description="COM_STANDARD_FLOAT_DESC">
            <option value="">JGLOBAL_USE_GLOBAL</option>
            <option value="right">COM_STANDARD_RIGHT</option>
            <option value="left">COM_STANDARD_LEFT</option>
            <option value="none">COM_STANDARD_NONE</option>
        </field>
        <field name="map_intro_title" type="text" label="COM_STANDARD_FIELD_IMAGE_TITLE_LABEL" description="COM_STANDARD_FIELD_IMAGE_TITLE_DESC"/>
        <field name="map_intro_alt" type="text" label="COM_STANDARD_FIELD_IMAGE_ALT_LABEL" description="COM_STANDARD_FIELD_IMAGE_ALT_DESC" size="20"/>
        <field name="map_intro_caption" type="text" label="COM_STANDARD_FIELD_IMAGE_CAPTION_LABEL" description="COM_STANDARD_FIELD_IMAGE_CAPTION_DESC" size="20"/>
        <field name="spacer2" type="spacer" hr="true" />
        <field name="COM_STANDARD_FIELD_FULL_LABEL" type="spacer" description="COM_STANDARD_FIELD_FULL_DESC" />
        <field name="float_fulltext" type="list" label="COM_STANDARD_FLOAT_LABEL" description="COM_STANDARD_FLOAT_DESC">
            <option value="">JGLOBAL_USE_GLOBAL</option>
            <option value="right">COM_STANDARD_RIGHT</option>
            <option value="left">COM_STANDARD_LEFT</option>
            <option value="none">COM_STANDARD_NONE</option>
        </field>
        <field name="map_fulltext_title" type="text" label="COM_STANDARD_FIELD_IMAGE_TITLE_LABEL" description="COM_STANDARD_FIELD_IMAGE_TITLE_DESC"/>
        <field name="map_fulltext_alt"
               type="text"
               label="COM_STANDARD_FIELD_IMAGE_ALT_LABEL"
               description="COM_STANDARD_FIELD_IMAGE_ALT_DESC"
               size="20"/>
        <field name="map_fulltext_caption"
               type="text"
               label="COM_STANDARD_FIELD_IMAGE_CAPTION_LABEL"
               description="COM_STANDARD_FIELD_IMAGE_CAPTION_DESC"
               size="20"/>
    </fields>

    <fields name="params" label="COM_STANDARD_CATEGORIES_FIELD_BASIC_LABEL">

        <fieldset name="basic">

            <field
                name="category_layout"
                type="componentlayout"
                label="JFIELD_ALT_LAYOUT_LABEL"
                description="JFIELD_ALT_COMPONENT_LAYOUT_DESC"
                view="category"
                useglobal="true"
            />

            <field
                name="image"
                type="media"
                label="COM_STANDARD_CATEGORIES_FIELD_IMAGE_LABEL"
                description="COM_STANDARD_CATEGORIES_FIELD_IMAGE_DESC"
            />

            <field 
                name="image_alt"
                type="text"
                label="COM_STANDARD_CATEGORIES_FIELD_IMAGE_ALT_LABEL"
                description="COM_STANDARD_CATEGORIES_FIELD_IMAGE_ALT_DESC"
                size="20"
            />
        </fieldset>
    </fields>

    <fields name="metadata" label="JGLOBAL_FIELDSET_METADATA_OPTIONS">

        <fieldset name="jmetadata" label="JGLOBAL_FIELDSET_METADATA_OPTIONS">

            <field
                name="author"
                type="text"
                label="JAUTHOR"
                description="JFIELD_METADATA_AUTHOR_DESC"
                size="30"
            />

            <field
                name="robots"
                type="list"
                label="JFIELD_METADATA_ROBOTS_LABEL"
                description="JFIELD_METADATA_ROBOTS_DESC"
            >
                <option value="">JGLOBAL_USE_GLOBAL</option>
                <option value="index, follow">JGLOBAL_INDEX_FOLLOW</option>
                <option value="noindex, follow">JGLOBAL_NOINDEX_FOLLOW</option>
                <option value="index, nofollow">JGLOBAL_INDEX_NOFOLLOW</option>
                <option value="noindex, nofollow">JGLOBAL_NOINDEX_NOFOLLOW</option>
            </field>
        </fieldset>
    </fields>
</form>
