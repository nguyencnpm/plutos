<?xml version="1.0" encoding="utf-8"?>
<form>
    <fieldset ><!-- addfieldpath="/administrator/components/com_categories/models/fields" -->
        <field name="id"  type="text" class="readonly" label="JGLOBAL_FIELD_ID_LABEL"
               description ="JGLOBAL_FIELD_ID_DESC" size="10" default="0"
               readonly="true" />

        <field name="title" type="text" label="JGLOBAL_TITLE"
               description="JFIELD_TITLE_DESC"
               class="input-xxlarge input-large-text"
               size="40"
               required="true" />

        <field name="alias" type="text" label="JFIELD_ALIAS_LABEL"
               description="JFIELD_ALIAS_DESC"
               hint="JFIELD_ALIAS_PLACEHOLDER"
               size="40" />
        
        <field name="value_mathop" type="list"  label="COM_STANDARD_VALUE_MATHOP" description="COM_STANDARD_VALUE_MATHOP" 
               default="netrate"  required="true">
            <option value="netrate">Net Rate</option>
            <option value="-%">-%</option>
            <option value="-">-</option>
        </field>
        
        <field name="currency_id" type="listcurrencies" label="COM_STANDARD_CURRENCY" description="COM_STANDARD_CURRENCY" 
               default="147" required="true" showon="value_mathop:-[OR]value_mathop:+[OR]value_mathop:netrate" />

        <field name="value" type="number" label="COM_STANDARD_VALUE" description="COM_STANDARD_VALUE" 
               default="0" required="true" step="0.0001"  min="0.0001" />
        
        <field name="start_date" type="calendar"
               label="COM_STANDARD_FIELD_START_DATE_LABEL" description="COM_STANDARD_FIELD_START_DATE_DESC" 
               translateformat="true"
               showtime="false"
               filter="user_utc" />
        <field name="expiry_date" type="calendar"
               label="COM_STANDARD_FIELD_EXPIRY_DATE_LABEL" description="COM_STANDARD_FIELD_EXPIRY_DATE_DESC" 
               translateformat="true"
               showtime="false"
               filter="user_utc" />
        
        <field name="catid" type="categoryedit" label="JCATEGORY"
               description="JFIELD_CATEGORY_DESC"
               class="span12" default="" multiple="true" />
        
        <field name="manufacturer_id" type="ListManufacturers" label="COM_STANDARD_MANUFACTURER" description="COM_STANDARD_MANUFACTURER_DESC"
               class="span12" multiple="true" />
        
        <field  name="descr" type="textarea" label="COM_STANDARD_DESCR" description="COM_STANDARD_DESCR"
                rows="3" class="span12"
        />
        
        <field name="promotiontext" type="editor" label="COM_STANDARD_FIELD_PROMOTIONTEXT_LABEL" description="COM_STANDARD_FIELD_PROMOTIONTEXT_DESC"
               filter="JComponentHelper::filterText" buttons="true" 
        />
        
        <field name="state" type="list" label="JSTATUS" description="JFIELD_PUBLISHED_DESC" 
               class="chzn-color-state" filter="intval" size="1" default="1"
        >
            <option value="1">
                JPUBLISHED</option>
            <option value="0">
                JUNPUBLISHED</option>
            <option value="2">
                JARCHIVED</option>
            <option value="-2">
                JTRASHED</option>
        </field>

        <field
            name="buttonspacer"
            description="JGLOBAL_ACTION_PERMISSIONS_DESCRIPTION"
            type="spacer" />

        <field name="created" type="calendar" label="COM_STANDARD_FIELD_CREATED_LABEL"
               description="COM_STANDARD_FIELD_CREATED_DESC" 
               translateformat="true"
               weeknumbers="true"
               showtime="true"
               size="22"
               filter="user_utc" />

        <field name="created_by" type="user"
               label="COM_STANDARD_FIELD_CREATED_BY_LABEL" description="COM_STANDARD_FIELD_CREATED_BY_DESC" />

        <field name="created_by_alias" type="text"
               label="COM_STANDARD_FIELD_CREATED_BY_ALIAS_LABEL" description="COM_STANDARD_FIELD_CREATED_BY_ALIAS_DESC"
               size="20" />

        <field name="modified" type="calendar" class="readonly"
               label="JGLOBAL_FIELD_MODIFIED_LABEL" description="COM_STANDARD_FIELD_MODIFIED_DESC"
               translateformat="true"
               showtime="true"
               size="22"
               readonly="true"
               filter="user_utc" />

        <field name="modified_by" type="user"
               label="JGLOBAL_FIELD_MODIFIED_BY_LABEL"
               class="readonly"
               readonly="true"
               filter="unset"
        />

        <field name="checked_out" type="hidden" filter="unset" />

        <field name="checked_out_time" type="hidden" filter="unset" />
        
        <field name="publish_up" type="calendar"
               label="COM_STANDARD_FIELD_PUBLISH_UP_LABEL" description="COM_STANDARD_FIELD_PUBLISH_UP_DESC"
               translateformat="true"
               showtime="true"
               size="22"
               filter="user_utc" />

        <field name="publish_down" type="calendar"
               label="COM_STANDARD_FIELD_PUBLISH_DOWN_LABEL" description="COM_STANDARD_FIELD_PUBLISH_DOWN_DESC"
               translateformat="true"
               showtime="true"
               size="22"
               filter="user_utc" />
        
        <field name="version" type="text" class="readonly"
               label="COM_STANDARD_FIELD_VERSION_LABEL" size="6" description="COM_STANDARD_FIELD_VERSION_DESC"
               readonly="true" filter="unset" />

        <field name="ordering" type="text" label="JFIELD_ORDERING_LABEL"
               description="JFIELD_ORDERING_DESC" size="6"
               default="0" />

        <field name="access" type="accesslevel" label="JFIELD_ACCESS_LABEL"
               description="JFIELD_ACCESS_DESC" size="1" />

        <field name="language" type="contentlanguage" label="JFIELD_LANGUAGE_LABEL"
               description="COM_STANDARD_FIELD_LANGUAGE_DESC"
        >
            <option value="*">JALL</option>
        </field>

        <field name="rules" type="rules" label="JFIELD_RULES_LABEL"
               translate_label="false" filter="rules"
               component="com_standard" section="promotion" validate="rules"
        />
        
        <field name="xreference" type="text"
               label="JFIELD_KEY_REFERENCE_LABEL"
               description="JFIELD_KEY_REFERENCE_DESC"
               size="20"
        />
            
        <fields name="images" label="COM_STANDARD_FIELD_IMAGE_OPTIONS">
            <field name="linktype" 
                   type="list" 
                   label="COM_STANDARD_LINK_TYPE"
                   description="COM_STANDARD_LINK_TYPE_DESC" 
                   default=""
            >
                <option value="">COM_STANDARD_DO_NOT_LINK</option>
                <option value="current">COM_STANDARD_CURRENT_LINK</option>
                <option value="menu">COM_STANDARD_MENU</option>
                <option value="url">COM_STANDARD_URL</option>
                <option value="article">COM_STANDARD_ARTICLE</option>
            </field>
        
            <field name="linkmenu" 
                   type="menuitem"
                   label="COM_STANDARD_MENU"
                   description="COM_STANDARD_MENU"
                   disable="separator,heading,alias"
                   showon="linktype:menu"
            />
            <field name="linkurl"
                   type="text"
                   label="COM_STANDARD_URL"
                   description="COM_STANDARD_URL"
                   class="inputbox"
                   size="30"
                   showon="linktype:url"
            />
            <field name="linkarticle" 
                   type="modal_article"
                   label="COM_STANDARD_ARTICLE" 
                   description="COM_STANDARD_ARTICLE"
                   select="true"
                   new="true"
                   edit="true"
                   clear="true"
                   showon="linktype:article"
            />
	
                
            <field
                name="url_type"
                type="radio"
                class="btn-group btn-group-yesno"
                default="1"
                label="COM_STANDARD_SHOW_URL_LABEL"
                description="COM_STANDARD_SHOW_URL_DESC"
                showon="linktype:current,menu,url,article"
            >
                <option value="1">COM_STANDARD_FIELD_URL_ARTICLE_LABEL</option>
                <option value="2">COM_STANDARD_FIELD_URL_IMAGE_LABEL</option>
            </field>
        
            <field name="urltext"
                   type="text"
                   label="COM_STANDARD_FIELD_URL_LINK_TEXT_LABEL"
                   description="COM_STANDARD_FIELD_URL_LINK_TEXT_DESC"
                   showon="linktype:current,menu,url,article"
            />
        		
            <field name="linktarget" 
                   type="list" 
                   label="COM_STANDARD_LINK_TARGET"
                   description="COM_STANDARD_LINK_TARGET_DESC" 
                   default=""
                   showon="linktype:current,menu,url,article"
            >
                <option value="">COM_STANDARD_AUTO</option>
                <option value="_self">COM_STANDARD_PARENT_WINDOW</option>
                <option value="_blank">COM_STANDARD_NEW_WINDOW</option>
            </field>
            <field name="linktypehr" type="spacer" hr="true" />
        
            <field name="effect" type="list" 
                   label="COM_STANDARD_EFFECT_LABEL" 
                   description="COM_STANDARD_EFFECT_DESC">
                <option value="">COM_STANDARD_EFFECT_GLOBAL</option>
                <option value="1">COM_STANDARD_EFFECT_SCROLLING</option>
                <option value="2">COM_STANDARD_EFFECT_BACKGROUND</option>
            </field>
            <field name="scrollinghr" type="spacer" hr="true" />
        
            <field name="COM_STANDARD_FIELD_INTRO_LABEL" type="spacer" description="COM_STANDARD_FIELD_INTRO_DESC" />
            <field name="float_intro" type="list" label="COM_STANDARD_FLOAT_LABEL" description="COM_STANDARD_FLOAT_DESC">
                <option value="">JGLOBAL_USE_GLOBAL</option>
                <option value="right">COM_STANDARD_RIGHT</option>
                <option value="left">COM_STANDARD_LEFT</option>
                <option value="none">COM_STANDARD_NONE</option>
            </field>
            <field name="image_intro_title" type="text" label="COM_STANDARD_FIELD_IMAGE_TITLE_LABEL" description="COM_STANDARD_FIELD_IMAGE_TITLE_DESC"/>
            <field name="image_intro_alt" type="text" label="COM_STANDARD_FIELD_IMAGE_ALT_LABEL" description="COM_STANDARD_FIELD_IMAGE_ALT_DESC" size="20"/>
            <field name="image_intro_caption" type="text" label="COM_STANDARD_FIELD_IMAGE_CAPTION_LABEL" description="COM_STANDARD_FIELD_IMAGE_CAPTION_DESC" size="20"/>
            <field name="spacer2" type="spacer" hr="true" />
            <field name="COM_STANDARD_FIELD_FULL_LABEL" type="spacer" description="COM_STANDARD_FIELD_FULL_DESC" />
            <field name="float_fulltext" type="list" label="COM_STANDARD_FLOAT_LABEL" description="COM_STANDARD_FLOAT_DESC">
                <option value="">JGLOBAL_USE_GLOBAL</option>
                <option value="right">COM_STANDARD_RIGHT</option>
                <option value="left">COM_STANDARD_LEFT</option>
                <option value="none">COM_STANDARD_NONE</option>
            </field>
            <field name="image_fulltext_title" type="text" label="COM_STANDARD_FIELD_IMAGE_TITLE_LABEL" description="COM_STANDARD_FIELD_IMAGE_TITLE_DESC"/>
            <field name="image_fulltext_alt"
                   type="text"
                   label="COM_STANDARD_FIELD_IMAGE_ALT_LABEL"
                   description="COM_STANDARD_FIELD_IMAGE_ALT_DESC"
                   size="20"/>
            <field name="image_fulltext_caption"
                   type="text"
                   label="COM_STANDARD_FIELD_IMAGE_CAPTION_LABEL"
                   description="COM_STANDARD_FIELD_IMAGE_CAPTION_DESC"
                   size="20"/>
        </fields>
        
    </fieldset>
    <fields name="metadata" label="JGLOBAL_FIELDSET_METADATA_OPTIONS">
        <fieldset name="jmetadata"
                  label="JGLOBAL_FIELDSET_METADATA_OPTIONS">

            <field name="robots"
                   type="list"
                   label="JFIELD_METADATA_ROBOTS_LABEL"
                   description="JFIELD_METADATA_ROBOTS_DESC"
            >
                <option value="">JGLOBAL_USE_GLOBAL</option>
                <option value="index, follow">JGLOBAL_INDEX_FOLLOW</option>
                <option value="noindex, follow">JGLOBAL_NOINDEX_FOLLOW</option>
                <option value="index, nofollow">JGLOBAL_INDEX_NOFOLLOW</option>
                <option value="noindex, nofollow">JGLOBAL_NOINDEX_NOFOLLOW</option>
            </field>

            <field name="author" type="text"
                   label="JAUTHOR" description="JFIELD_METADATA_AUTHOR_DESC"
                   size="20" />

            <field name="rights" type="textarea" label="JFIELD_META_RIGHTS_LABEL"
                   description="JFIELD_META_RIGHTS_DESC" required="false" filter="string"
                   cols="30" rows="2" />
            <field name="xreference" type="text"
                   label="COM_STANDARD_FIELD_XREFERENCE_LABEL"
                   description="COM_STANDARD_FIELD_XREFERENCE_DESC"
                   size="20" />
        </fieldset>
    </fields>
    <!-- These fields are used to get labels for the Content History Preview and Compare Views -->
    <fields>
        <field name="introtext" label="COM_STANDARD_FIELD_INTROTEXT" />
        <field name="fulltext" label="COM_STANDARD_FIELD_FULLTEXT" />
    </fields>
    
</form>
