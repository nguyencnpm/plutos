<?xml version="1.0" encoding="utf-8"?>
<extension version="3.2" type="plugin" group="gpshipment" method="upgrade">
    <name>plg_gpshipment_shipment</name>
    <author>Binh Nguyen! Project</author>
    <creationDate>January 2014</creationDate>
    <copyright>Copyright (C) 2005 - 2018 Open Source Matters. All rights reserved.</copyright>
    <license>GNU General Public License version 2 or later; see LICENSE.txt</license>
    <authorEmail>admin@giaiphapcongnghethongtin.vn</authorEmail>
    <authorUrl>www.giaiphapcongnghethongtin.vn</authorUrl>
    <version>3.2.2</version>
    <description>PLG_GPSHIPMENT_SHIPMENT_XML_DESCRIPTION</description>
    <files>
        <folder>language</folder>
        <folder>tmpl</folder>
        <filename plugin="shipment">shipment.php</filename>
    </files>
    <languages>
        <!--        
        <language tag="en-GB">en-GB/en-GB.plg_gpshipment_shipment.ini</language>
        <language tag="en-GB">en-GB/en-GB.plg_gpshipment_shipment.sys.ini</language>
        -->
    </languages>
    <config>
        <fields name="params">
            <fieldset name="basic">
                <field
                    name="url"
                    type="list"
                    label="PLG_GPSHIPMENT_SHIPMENT_PARAM_URL_LABEL"
                    description="PLG_GPSHIPMENT_SHIPMENT_PARAM_URL_DESCRIPTION"
                    default="url"
                >
                    <option value="url">PLG_GPSHIPMENT_SHIPMENT_PARAM_URL_URL</option>
                    <option value="webpage">PLG_GPSHIPMENT_SHIPMENT_PARAM_URL_WEBPAGE</option>
                    <option value="email">PLG_GPSHIPMENT_SHIPMENT_PARAM_URL_EMAIL</option>
                </field>

                <field
                    name="link_to_alias"
                    type="radio"
                    label="PLG_GPSHIPMENT_SHIPMENT_PARAM_ALIAS_LABEL"
                    description="PLG_GPSHIPMENT_SHIPMENT_PARAM_ALIAS_DESCRIPTION"
                    default="0"
                    class="btn-group btn-group-yesno"
                    filter="integer"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
            </fieldset>
        </fields>
    </config>
</extension>
