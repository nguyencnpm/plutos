<?xml version="1.0" encoding="UTF-8"?>
<form>
    <fieldset name="checkAvailability" addrulepath="components/com_standard/models/rules" label="COM_STANDARD_CONTACT_REQUEST_DEFAULT_LABEL">
        <field
            name="spacer"
            type="spacer"
            label="COM_STANDARD_CONTACT_REQUIRED"
            class="text"
        />
        
        <field
            name="tour_id"
            type="Tour"
            default="" 
            class="form-control using-bg-green-dark selectpicker show-tick dropupAuto radius-0"
            label="COM_STANDARD_TOURS_LABEL"
            description="COM_STANDARD_TOURS_DESC"
            hint="COM_STANDARD_TOURS"
        >
        </field>
       
        <field
            name="contact_adult"
            type="Adults"
            default="1" 
            class="form-control using-bg-green-dark selectpicker dropupAuto radius-0"
            label="COM_STANDARD_ADULT_LABEL"
            description="COM_STANDARD_ADULT_DESC"
            hint="COM_STANDARD_ADULT"
        >
        </field>
        
        <field
            name="contact_children"
            type="Children"
            default="0" 
            class="form-control using-bg-green-dark selectpicker dropupAuto radius-0"
            label="COM_STANDARD_CHILDREN_LABEL"
            description="COM_STANDARD_CHILDREN_DESC"
            hint="COM_STANDARD_CHILDREN"
        >
        </field>
        
        <field
            name="contact_infant"
            type="Infant"
            default="0" 
            class="form-control using-bg-green-dark selectpicker dropupAuto radius-0"
            label="COM_STANDARD_INFANT_LABEL"
            description="COM_STANDARD_INFANT_DESC"
            hint="COM_STANDARD_ADULT"
        >
        </field>
              
        <field
            name="contact_checkin"
            type="Datetimepicker"
            class="form-control using-bg-green-dark using-border-green-dark text-white radius-0"
            label="COM_STANDARD_CONTACT_CHECK_IN_DATE_LABEL"
            description="COM_STANDARD_CONTACT_CHECK_IN_DATE_DESC"
            filter="string"
            hint="COM_STANDARD_CONTACT_CHECK_IN_DATE_PLACEHOLDER"
        />

    </fieldset>
    <fieldset name="captcha">
        <field
            name="captcha"
            type="captcha"
            label="COM_STANDARD_CAPTCHA_LABEL"
            description="COM_STANDARD_CAPTCHA_DESC"
            validate="captcha"
            namespace="contact"
        />
    </fieldset>
</form>
